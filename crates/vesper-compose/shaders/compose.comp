// Composes up to 16 layers into the output image. Regenerate compose.spv
// with scripts/shaders.sh after editing.
//
// Layers are drawn bottom to top over opaque black. Colours stay in their
// sRGB encoding: a fully opaque pixel is copied as is (bit-exact when the
// layer is not scaled), and only pixels with alpha < 1 are blended, in
// linear light. Textures hold premultiplied alpha.
#version 450

layout(local_size_x = 16, local_size_y = 16) in;

struct Layer {
    vec4 dst;   // destination rect in output pixels: x0, y0, x1, y1
    vec4 src;   // source texel at dst (x0, y0), then texels per output pixel (x, y)
    vec4 misc;  // opacity, mip level, 1 / texture width, 1 / texture height
    uvec4 flags; // x: FLAG_* bits
};

layout(set = 0, binding = 0, std140) uniform Params {
    uvec4 head; // x: layer count, y: write BGRA (XR24 memory order) when != 0
    Layer layers[16];
};
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D out_image;
layout(set = 0, binding = 2) uniform sampler2D textures[16];

const uint FLAG_NO_ALPHA = 1u; // X formats: the alpha byte is padding
const uint FLAG_SWAP_RB = 2u;  // the texture holds BGRA
const uint FLAG_EXACT = 4u;    // 1:1 at whole-pixel offsets: fetch, do not filter

vec3 to_linear(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), greaterThan(c, vec3(0.04045)));
}

vec3 to_srgb(vec3 c) {
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, greaterThan(c, vec3(0.0031308)));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(out_image)))) {
        return;
    }
    vec2 pc = vec2(p) + 0.5;
    vec3 c = vec3(0.0);
    uint n = min(head.x, 16u);
    for (uint i = 0u; i < n; i++) {
        Layer l = layers[i];
        if (pc.x < l.dst.x || pc.y < l.dst.y || pc.x >= l.dst.z || pc.y >= l.dst.w) {
            continue;
        }
        vec2 s = l.src.xy + (pc - l.dst.xy) * l.src.zw;
        vec4 t;
        if ((l.flags.x & FLAG_EXACT) != 0u) {
            t = texelFetch(textures[i], ivec2(s), 0);
        } else {
            t = textureLod(textures[i], s * l.misc.zw, l.misc.y);
        }
        if ((l.flags.x & FLAG_SWAP_RB) != 0u) {
            t = t.bgra;
        }
        if ((l.flags.x & FLAG_NO_ALPHA) != 0u) {
            t.a = 1.0;
        }
        float a = t.a * l.misc.x;
        if (a >= 1.0) {
            c = t.rgb;
        } else if (a > 0.0) {
            vec3 straight = clamp(t.rgb / t.a, 0.0, 1.0);
            c = to_srgb(mix(to_linear(c), to_linear(straight), a));
        }
    }
    imageStore(out_image, p, vec4(head.y != 0u ? c.bgr : c, 1.0));
}
