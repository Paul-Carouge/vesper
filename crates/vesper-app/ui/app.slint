// Vesper main window. The UI only renders state and emits intents: the backend
// owns the truth and writes back the `in` properties.

import { Theme, Icons } from "theme.slint";
import { Icon, Logo, Card, Button, IconButton, Switch, Segmented, Meter, SectionLabel, FocusRing, Slider, TextField, SelectField } from "components.slint";

export { Theme }

export enum TrackKind { desktop, microphone, output, input, app }
/// A filter parameter. `index` is its place in the filter's parameters.
export struct FilterParam { index: int, label: string, unit: string, value: float, minimum: float, maximum: float, step: float }
/// One filter of a track. `kind` is the backend's filter name; `meters`: it
/// reduces gain and shows how much. Parameters are split: `main` always
/// shown, `advanced` behind "More settings".
export struct FilterRow { kind: string, title: string, enabled: bool, meters: bool, main: [FilterParam], advanced: [FilterParam] }
/// A filter the "Add filter" menu offers.
export struct FilterKind { kind: string, title: string }
/// One audio track. `source` is the backend's id of what it records;
/// `source-label` names it ("Desktop audio", "Headset", "Firefox") and
/// `device` is the device it records, if named ("Speakers (USB DAC)").
export struct AudioTrack { name: string, source: string, source-label: string, device: string, kind: TrackKind, enabled: bool, muted: bool, volume-db: float, filters: [FilterRow] }
/// A source a picker offers. `section` heads the first of a group; `added`:
/// a track records it; `detail` is shown after the label ("Default",
/// "Disconnected").
export struct SourceOption { label: string, source: string, kind: TrackKind, section: string, added: bool, detail: string }
/// A device chosen for the Desktop audio or Microphone tracks. `name` is its
/// `node.name`, empty for the system default; `connected`: it is plugged in.
export struct DeviceChoice { name: string, label: string, connected: bool }

export enum SourceKind { none, screen, window, game }
/// A game connected through the Vulkan layer that may be captured.
export struct GameEntry { name: string, pid: int }
// A saved profile: its file name and its name.
export struct ProfileEntry { slug: string, name: string }
export enum VideoCodec { av1, hevc, h264 }
export enum QualityPreset { performance, balanced, quality }
/// Recording lifecycle, owned by the backend. `starting` covers the portal
/// picker and encoder setup, `stopping` the encoder flush and muxer close.
export enum RecState { idle, starting, recording, stopping }
// Where the live stream goes.
export enum LiveService { twitch, youtube, custom }
// `off -> connecting -> live (<-> reconnecting) -> ending -> off`.
export enum LiveState { off, connecting, live, reconnecting, ending }

// Elapsed time with fixed-width digit cells, so the clock does not jitter.
component Clock inherits HorizontalLayout {
    in property <int> seconds;
    in property <brush> color;
    property <int> h: Math.min(99, Math.floor(root.seconds / 3600));
    property <int> m: Math.mod(Math.floor(root.seconds / 60), 60);
    property <int> s: Math.mod(root.seconds, 60);
    property <[int]> digits: [
        Math.floor(h / 10),
        Math.mod(h, 10),
        -1,
        Math.floor(m / 10),
        Math.mod(m, 10),
        -1,
        Math.floor(s / 10),
        Math.mod(s, 10)
    ];

    alignment: center;
    accessible-role: text;
    accessible-label: "Elapsed time";
    accessible-value: "\{h}:\{m < 10 ? "0" : ""}\{m}:\{s < 10 ? "0" : ""}\{s}";
    for d in root.digits: Text {
        width: d < 0 ? Theme.font-display * 0.32 : Theme.font-display * 0.6;
        text: d < 0 ? ":" : "\{d}";
        horizontal-alignment: center;
        font-size: Theme.font-display;
        font-weight: 300;
        color: d < 0 ? Theme.text-faint : root.color;
    }
}

component RecordButton inherits FocusScope {
    in property <bool> recording;
    /// Starting or stopping: the button shows the pending state and ignores input.
    in property <bool> busy;
    in property <string> shortcut;
    callback toggle;

    width: 88px;
    height: 88px;
    focus-on-click: false;
    accessible-role: button;
    accessible-label: root.busy
        ? (root.recording ? "Stopping recording" : "Starting recording")
        : root.recording ? "Stop recording" : "Start recording";
    accessible-description: root.shortcut;
    accessible-enabled: root.enabled && !root.busy;
    accessible-action-default => {
        if (root.enabled && !root.busy) {
            root.toggle();
        }
    }

    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            if (!root.busy) {
                root.toggle();
            }
            return accept;
        }
        reject
    }

    // Soft halo that breathes while recording.
    halo := Rectangle {
        property <float> phase: root.recording ? (1 + Math.sin(animation-tick() / 1.6s * 360deg)) / 2 : 0;
        width: parent.width + 14px + 10px * self.phase;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.rec-soft;
        opacity: root.recording ? 0.5 + 0.5 * self.phase : touch.has-hover ? 0.7 : 0;
        animate opacity { duration: Theme.medium; }
    }

    FocusRing {
        visible-ring: root.has-focus;
        radius: root.width / 2;
        offset: 5px;
    }

    ring := Rectangle {
        border-radius: self.width / 2;
        background: Theme.surface;
        border-width: 3px;
        border-color: root.recording ? Theme.rec : Theme.border-strong;
        animate border-color { duration: Theme.medium; }
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: Theme.dark ? #00000066 : #1a1a2a22;
    }

    // Circle (idle) morphs into a rounded square (stop).
    core := Rectangle {
        property <length> size: root.recording ? 34px : touch.pressed ? 62px : 68px;
        width: self.size;
        height: self.size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: root.recording ? 9px : self.size / 2;
        background: touch.has-hover ? Theme.rec.brighter(0.08) : Theme.rec;
        opacity: root.busy ? 0.5 : 1;
        animate width, height, border-radius, opacity { duration: Theme.medium; easing: ease-out-quart; }
    }

    touch := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => {
            root.toggle();
        }
    }
}

// A card row label with an optional secondary line.
component Labeled inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    /// Wraps a long subtitle instead of eliding it.
    in property <bool> wrap-subtitle;
    alignment: center;
    spacing: 2px;
    Text {
        text: root.title;
        font-size: Theme.font-body;
        font-weight: 600;
        color: Theme.text;
        overflow: elide;
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        font-size: Theme.font-small;
        color: Theme.text-muted;
        wrap: root.wrap-subtitle ? word-wrap : no-wrap;
        overflow: elide;
    }
}

// Labels of the audio tracks.
global TrackText {
    // "-3 dB", "+1.5 dB", "Silent" at the bottom of the range.
    public pure function volume(db: float) -> string {
        db <= -60 ? "Silent" : (db > 0 ? "+" : "") + "\{Math.round(db * 2) / 2} dB"
    }

    public pure function icon(kind: TrackKind, muted: bool) -> string {
        kind == TrackKind.microphone || kind == TrackKind.input
            ? (muted ? Icons.mic-off : Icons.mic)
            : kind == TrackKind.app ? (muted ? Icons.app-off : Icons.app) : (muted ? Icons.speaker-off : Icons.speaker)
    }

    public pure function kind(kind: TrackKind) -> string {
        kind == TrackKind.desktop ? "Desktop audio"
            : kind == TrackKind.microphone ? "Microphone"
            : kind == TrackKind.output ? "Output device"
            : kind == TrackKind.input ? "Input device" : "Application"
    }

    // The device it records ("Speakers (USB DAC)"), else its kind. The icon
    // and the name tell the kind: the narrow column keeps the device whole.
    public pure function source(track: AudioTrack) -> string {
        track.device == "" ? TrackText.kind(track.kind) : track.device
    }

    // What a device selector shows.
    public pure function device(choice: DeviceChoice) -> string {
        choice.name == "" ? "System default" : choice.connected ? choice.label : "\{choice.label} (disconnected)"
    }
}

component AudioRow inherits HorizontalLayout {
    in property <AudioTrack> track;
    in property <float> level;
    in property <float> peak;
    in property <bool> interactive: true;
    /// Its settings are shown below it.
    in property <bool> open;
    callback toggle-mute;
    callback toggle-open;

    property <bool> silent: root.track.muted || !root.track.enabled;

    spacing: Theme.space-md;
    alignment: stretch;

    IconButton {
        icon: TrackText.icon(root.track.kind, root.track.muted);
        label: root.track.muted ? "Unmute \{root.track.name}" : "Mute \{root.track.name}";
        active: root.track.muted;
        active-tint: Theme.rec;
        enabled: root.interactive;
        clicked => {
            root.toggle-mute();
        }
    }

    VerticalLayout {
        width: 112px;
        alignment: center;
        spacing: 1px;
        Text {
            text: root.track.name;
            font-size: Theme.font-body;
            font-weight: 500;
            color: root.silent ? Theme.text-muted : Theme.text;
            overflow: elide;
        }
        Text {
            text: !root.track.enabled ? "Not recorded"
                : root.track.muted ? "Muted"
                : root.track.volume-db != 0 ? TrackText.volume(root.track.volume-db) : TrackText.source(root.track);
            font-size: Theme.font-caption;
            font-weight: root.track.muted && root.track.enabled ? 600 : 400;
            color: root.track.muted && root.track.enabled ? Theme.rec : Theme.text-muted;
            overflow: elide;
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Meter {
            level: root.level;
            peak: root.peak;
            muted: root.silent;
        }
    }

    IconButton {
        icon: Icons.sliders;
        label: "Settings of \{root.track.name}";
        active: root.open;
        enabled: root.interactive;
        clicked => {
            root.toggle-open();
        }
    }
}

// A source in a picker: "Add track" adds it, a selector (`choosing`)
// picks it, `selected` being the current choice.
component SourceRow inherits FocusScope {
    in property <SourceOption> option;
    in property <bool> choosing;
    in property <bool> selected;
    // Focused once shown (a list opened from the keyboard).
    in property <bool> take-focus;
    callback clicked;
    // Escape: the list closes.
    callback cancel;

    // A source another track records cannot be picked again.
    property <bool> taken: root.option.added && !root.selected;
    property <string> spoken: root.option.detail != "" ? "\{root.option.label} (\{root.option.detail})" : root.option.label;
    // Desktop audio and Microphone name their device under the label.
    property <bool> below: root.option.detail != "" && (root.option.kind == TrackKind.desktop || root.option.kind == TrackKind.microphone);

    init => {
        if (self.take-focus) {
            self.focus();
        }
    }

    focus-on-click: false;
    height: root.below ? 44px : 36px;
    accessible-role: list-item;
    accessible-label: root.taken ? "\{root.spoken} (already a track)" : root.choosing ? root.spoken : "Add \{root.spoken}";
    accessible-item-selectable: root.choosing;
    accessible-item-selected: root.selected;
    accessible-enabled: root.enabled && !root.taken;
    accessible-action-default => {
        if (root.enabled && !root.taken) {
            root.clicked();
        }
    }

    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            if (root.enabled && !root.taken) { root.clicked(); }
            return accept;
        }
        if (event.text == Key.Escape) {
            root.cancel();
            return accept;
        }
        reject
    }

    FocusRing {
        visible-ring: root.has-focus;
        radius: Theme.radius-sm;
    }

    Rectangle {
        border-radius: Theme.radius-sm;
        background: touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-hover : transparent;
        animate background { duration: Theme.fast; }
    }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-sm;
        opacity: root.taken ? 0.45 : 1;
        Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            data: TrackText.icon(root.option.kind, false);
            tint: root.selected ? Theme.accent : Theme.text-muted;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.option.label;
                font-size: Theme.font-body;
                font-weight: root.selected ? 600 : 400;
                color: Theme.text;
                overflow: elide;
            }
            if root.below: Text {
                text: root.option.detail;
                font-size: Theme.font-caption;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
        // The label keeps most of the row: a long detail elides first.
        if root.option.detail != "" && !root.below && !root.taken: Text {
            max-width: 120px;
            text: root.option.detail;
            vertical-alignment: center;
            font-size: Theme.font-caption;
            color: root.option.detail == "Disconnected" ? Theme.warn : Theme.text-muted;
            overflow: elide;
        }
        if root.taken: Text {
            text: "Added";
            vertical-alignment: center;
            font-size: Theme.font-caption;
            color: Theme.text-muted;
        }
        if root.selected: Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            data: Icons.check;
            tint: Theme.accent;
        }
    }

    touch := TouchArea {
        enabled: root.enabled && !root.taken;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// The rows of a picker under their section headings. `current`: the
// source a selector (`choosing`) has now.
component SourceList inherits VerticalLayout {
    in property <[SourceOption]> options;
    in property <bool> choosing;
    in property <string> current;
    in property <string> label;
    // Opened from the keyboard: the current row (else the first) takes
    // focus, again when the rows are refreshed.
    in property <bool> focus-current;
    callback picked(SourceOption);
    callback cancel;

    spacing: 2px;
    accessible-role: list;
    accessible-label: root.label;
    for option[k] in root.options: VerticalLayout {
        spacing: 2px;
        if option.section != "": SectionLabel {
            x: Theme.space-sm;
            height: 24px;
            vertical-alignment: bottom;
            text: option.section;
        }
        SourceRow {
            option: option;
            choosing: root.choosing;
            selected: root.choosing && option.source == root.current;
            // The first row, then the current one, later, takes it over.
            take-focus: root.focus-current && (k == 0 || self.selected);
            clicked => {
                root.picked(option);
            }
            cancel => {
                root.cancel();
            }
        }
    }
}

// A device selector of the settings: its name, the choice, and the list of
// devices while it is open.
component DevicePicker inherits VerticalLayout {
    in property <string> title;
    in property <DeviceChoice> choice;
    in property <[SourceOption]> options;
    in property <bool> locked;
    // The default entry's source id ("desktop", "microphone").
    in property <string> default-source;
    // Stateless: the parent owns `open` and updates it from `opened`.
    in property <bool> open;
    callback opened(bool);
    callback chosen(SourceOption);

    spacing: Theme.space-xs;
    Text {
        text: root.title;
        font-size: Theme.font-small;
        font-weight: 600;
        color: Theme.text;
    }
    field := SelectField {
        label: root.title;
        text: TrackText.device(root.choice);
        warn: !root.choice.connected;
        expanded: root.open;
        enabled: !root.locked;
        description: root.locked ? "Locked while recording" : !root.choice.connected ? "Disconnected: recorded again once it is back" : "";
        clicked => {
            root.opened(!root.open);
        }
    }
    if root.open: SourceList {
        options: root.options;
        focus-current: field.keyboard;
        choosing: true;
        current: root.choice.name == "" ? root.default-source : (root.default-source == "desktop" ? "output:" : "input:") + root.choice.name;
        label: root.title;
        picked(option) => {
            root.opened(false);
            field.focus();
            root.chosen(option);
        }
        cancel => {
            root.opened(false);
            field.focus();
        }
    }
}

global FilterText {
    // "-20 dB", "3:1", "6500 Hz", "0.5 ms": decimals as fine as the step.
    public pure function value(p: FilterParam) -> string {
        p.unit == "ratio" ? "\{Math.round(p.value * 10) / 10}:1"
            : (p.step >= 1 ? "\{Math.round(p.value)}" : "\{Math.round(p.value * 10) / 10}") + " " + p.unit
    }
}

// One filter parameter: name, slider, value.
component ParamRow inherits HorizontalLayout {
    in property <FilterParam> param;
    in property <string> filter;
    callback changed(float);
    spacing: Theme.space-sm;
    Text {
        width: 76px;
        text: root.param.label;
        vertical-alignment: center;
        font-size: Theme.font-small;
        color: Theme.text-muted;
        overflow: elide;
    }
    Slider {
        horizontal-stretch: 1;
        label: "\{root.filter} \{root.param.label}";
        minimum: root.param.minimum;
        maximum: root.param.maximum;
        step: root.param.step;
        page-step: root.param.step * 10;
        value: root.param.value;
        value-text: FilterText.value(root.param);
        changed(v) => {
            root.changed(v);
        }
    }
    Text {
        width: 60px;
        text: FilterText.value(root.param);
        horizontal-alignment: right;
        vertical-alignment: center;
        font-size: Theme.font-small;
        color: Theme.text-muted;
    }
}

// A filter of the open track: on/off, gain reduction, order, parameters.
component FilterCard inherits Rectangle {
    in property <FilterRow> filter;
    // Gain reduction, dB (>= 0).
    in property <float> reduction;
    in property <bool> first;
    in property <bool> last;
    // Set by the list after it moved or removed a filter: -1 focuses the
    // "up" button, 1 "down", 2 the switch (0: nothing). Keeps keyboard focus
    // on the filter that moved, or on the next one after a removal.
    in property <int> take-focus;
    callback toggled(bool);
    callback param-changed(int, float);
    callback move(int);
    callback remove;

    property <bool> show-advanced;

    border-radius: Theme.radius-md;
    background: Theme.surface-raised;
    accessible-role: groupbox;
    accessible-label: root.filter.title;

    changed take-focus => {
        if (root.take-focus == -1) {
            if (up.enabled) { up.focus(); } else { down.focus(); }
        } else if (root.take-focus == 1) {
            if (down.enabled) { down.focus(); } else { up.focus(); }
        } else if (root.take-focus == 2) {
            toggle.focus();
        }
    }

    VerticalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-xs;
        padding-bottom: Theme.space-sm;
        spacing: Theme.space-xs;
        HorizontalLayout {
            spacing: Theme.space-sm;
            height: 36px;
            VerticalLayout {
                alignment: center;
                toggle := Switch {
                    label: root.filter.title;
                    checked: root.filter.enabled;
                    toggled(on) => {
                        root.toggled(on);
                    }
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.filter.title;
                vertical-alignment: center;
                font-size: Theme.font-body;
                font-weight: 500;
                color: root.filter.enabled ? Theme.text : Theme.text-muted;
                overflow: elide;
            }
            up := IconButton {
                width: 28px;
                height: 36px;
                icon: Icons.chevron-up;
                label: "Move \{root.filter.title} up";
                enabled: !root.first;
                opacity: self.enabled ? 1 : 0.35;
                clicked => {
                    root.move(-1);
                }
            }
            down := IconButton {
                width: 28px;
                height: 36px;
                icon: Icons.chevron-down;
                label: "Move \{root.filter.title} down";
                enabled: !root.last;
                opacity: self.enabled ? 1 : 0.35;
                clicked => {
                    root.move(1);
                }
            }
            IconButton {
                width: 28px;
                height: 36px;
                icon: Icons.close;
                label: "Remove \{root.filter.title}";
                clicked => {
                    root.remove();
                }
            }
        }
        VerticalLayout {
            padding-right: Theme.space-xs;
            spacing: Theme.space-xs;
            opacity: root.filter.enabled ? 1 : 0.6;
            // Gain reduction, laid out like a parameter. Purely visual (a
            // 30 Hz value), like the level meters. Unlike them it shows the
            // filter's own (already smoothed) dB, without peak hold, and keeps
            // its 70 ms `animate`: it only shows while a track's filters are open.
            if root.filter.meters && root.filter.enabled: HorizontalLayout {
                spacing: Theme.space-sm;
                height: 24px;
                accessible-role: none;
                Text {
                    width: 76px;
                    text: "Reduction";
                    vertical-alignment: center;
                    font-size: Theme.font-small;
                    color: Theme.text-muted;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.meter-track;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.reduction / 24, 0, 1);
                            border-radius: 2px;
                            background: Theme.meter-hot;
                            animate width { duration: 70ms; }
                        }
                    }
                }
                Text {
                    width: 60px;
                    text: root.reduction < 0.05 ? "0 dB" : "-\{Math.round(root.reduction * 10) / 10} dB";
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    font-size: Theme.font-small;
                    color: Theme.text-muted;
                }
            }
            for p in root.filter.main: ParamRow {
                param: p;
                filter: root.filter.title;
                changed(v) => {
                    root.param-changed(p.index, v);
                }
            }
            if root.show-advanced: VerticalLayout {
                spacing: Theme.space-xs;
                for p in root.filter.advanced: ParamRow {
                    param: p;
                    filter: root.filter.title;
                    changed(v) => {
                        root.param-changed(p.index, v);
                    }
                }
            }
            if root.filter.advanced.length > 0: HorizontalLayout {
                alignment: start;
                Button {
                    text: root.show-advanced ? "Fewer settings" : "More settings";
                    kind: "ghost";
                    small: true;
                    accessible-label: (root.show-advanced ? "Hide" : "Show") + " the advanced settings of \{root.filter.title}";
                    clicked => {
                        root.show-advanced = !root.show-advanced;
                    }
                }
            }
        }
    }
}

// A plain choice in an inline menu.
component MenuRow inherits FocusScope {
    in property <string> text;
    in property <string> label: root.text;
    callback clicked;

    focus-on-click: false;
    height: 32px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            root.clicked();
            return accept;
        }
        reject
    }

    FocusRing {
        visible-ring: root.has-focus;
        radius: Theme.radius-sm;
    }

    Rectangle {
        border-radius: Theme.radius-sm;
        background: touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-hover : transparent;
        animate background { duration: Theme.fast; }
    }

    Text {
        x: Theme.space-sm;
        width: parent.width - 2 * Theme.space-sm;
        text: root.text;
        vertical-alignment: center;
        font-size: Theme.font-body;
        color: Theme.text;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A profile in the profile menu; the current one is checked.
component ProfileRow inherits FocusScope {
    in property <string> name;
    in property <bool> selected;
    // Focused once shown (the menu opened from the keyboard).
    in property <bool> take-focus;
    callback clicked;

    init => {
        if (self.take-focus) {
            self.focus();
        }
    }

    focus-on-click: false;
    height: 36px;
    accessible-role: list-item;
    accessible-label: root.name;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            if (root.enabled) { root.clicked(); }
            return accept;
        }
        reject
    }

    FocusRing {
        visible-ring: root.has-focus;
        radius: Theme.radius-sm;
    }

    Rectangle {
        border-radius: Theme.radius-sm;
        background: touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-hover : transparent;
        animate background { duration: Theme.fast; }
    }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-sm;
        opacity: root.enabled || root.selected ? 1 : 0.45;
        Text {
            horizontal-stretch: 1;
            text: root.name;
            vertical-alignment: center;
            font-size: Theme.font-body;
            font-weight: root.selected ? 600 : 400;
            color: Theme.text;
            overflow: elide;
        }
        if root.selected: Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            data: Icons.check;
            tint: Theme.accent;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// A titled control inside a setting group.
component Field inherits VerticalLayout {
    in property <string> title;
    spacing: Theme.space-xs;
    Text {
        text: root.title;
        font-size: Theme.font-small;
        color: Theme.text-muted;
    }
    @children
}

component SettingGroup inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: Theme.space-sm;
    SectionLabel {
        text: root.label;
    }
    @children
    if root.hint != "": Text {
        text: root.hint;
        font-size: Theme.font-small;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}

export component AppWindow inherits Window {
    // ---- Source -------------------------------------------------------
    in property <SourceKind> source-kind: SourceKind.none;
    /// Human-readable source, e.g. "DP-1" or "Firefox".
    in property <string> source-name;
    /// Extra detail shown under the source name, e.g. "2560 × 1440".
    in property <string> source-detail;
    /// Game mode: other allowed games, to capture instead of the current one.
    in property <[GameEntry]> other-games;
    /// Process name of a game asking for consent; empty hides the prompt.
    in property <string> pending-game;
    /// The Vulkan layer is installed for this user.
    in-out property <bool> game-layer-installed;
    /// A layer built with this binary was found (it can be installed).
    in property <bool> game-layer-available;
    /// The installed layer differs from the one built with this binary.
    in property <bool> game-layer-outdated;

    // ---- Recording ----------------------------------------------------
    in property <RecState> rec-state: RecState.idle;
    in property <int> elapsed-seconds;

    // ---- Replay buffer ------------------------------------------------
    in-out property <bool> replay-enabled;
    /// One of 30, 60, 120.
    in-out property <int> replay-seconds: 30;
    /// RAM the buffer may take, e.g. "≈ 640 MB at 4K60 Quality".
    in property <string> replay-memory;

    // ---- Audio --------------------------------------------------------
    in property <[AudioTrack]> tracks;
    /// Linear levels of each track, 0..1.
    in property <[float]> track-levels;
    in property <[float]> track-peaks;
    /// What "Add track" and a track's Source offer, kept current while
    /// `watching-sources`.
    in property <[SourceOption]> source-options;
    /// Devices the Desktop audio and Microphone tracks record.
    in property <DeviceChoice> desktop-device: { connected: true };
    in property <DeviceChoice> mic-device: { connected: true };
    /// What the device selectors offer, kept current while `watching-sources`.
    in property <[SourceOption]> desktop-device-options;
    in property <[SourceOption]> mic-device-options;
    /// `source-options` lists applications.
    in property <bool> apps-playing;
    in property <int> max-tracks: 8;
    /// What "Add filter" offers.
    in property <[FilterKind]> filter-kinds;
    /// Gain reduction of each filter of the open track, dB.
    in property <[float]> filter-reductions;
    in property <int> max-filters: 16;
    /// A mix of all tracks as the files' first audio track.
    in-out property <bool> audio-mix: true;

    // ---- Output settings ----------------------------------------------
    in-out property <VideoCodec> codec: VideoCodec.av1;
    in-out property <QualityPreset> quality: QualityPreset.balanced;
    /// One of 30, 60, 120, 144.
    in-out property <int> fps: 60;
    in property <string> output-folder;
    /// `output-folder` as shown: its name ("Vesper") and where it is ("~/Videos").
    in property <string> output-folder-name;
    in property <string> output-folder-parent;

    // ---- Status line --------------------------------------------------
    in property <string> encoder: "VAAPI";
    in property <string> resolution;
    in property <float> measured-fps;
    in property <int> dropped-frames;
    /// Transient confirmation, e.g. "Replay saved". Empty hides it.
    in property <string> notice;
    /// The notice is about a saved file: it offers Open and Play.
    in property <bool> notice-has-file;

    in-out property <bool> settings-open;
    // Keys shown in hints: the global shortcuts once bound, else the in-window ones.
    in property <string> record-shortcut: "Ctrl+R";
    in property <string> replay-shortcut: "Ctrl+S";

    // ---- Intents --------------------------------------------------------
    callback pick-source();
    callback start-recording();
    callback stop-recording();
    callback save-replay();
    callback replay-changed(bool, int);
    callback track-mute-toggled(int);
    callback track-volume-changed(int, float);
    callback track-renamed(int, string);
    callback track-enabled-changed(int, bool);
    callback track-removed(int);
    /// A list of sources or devices is shown (or none any more): the backend
    /// watches them meanwhile.
    callback sources-watch-changed(bool);
    callback track-added(SourceOption);
    /// Track `i` records this source from now on.
    callback track-source-changed(int, SourceOption);
    /// The Microphone (true) or Desktop audio (false) device was chosen.
    callback device-chosen(bool, SourceOption);
    callback filter-toggled(int, int, bool);
    callback filter-param-changed(int, int, int, float);
    /// Track, filter, then -1 (up) or 1 (down).
    callback filter-moved(int, int, int);
    callback filter-removed(int, int);
    callback filter-added(int, string);
    // "Add filter" opened: the plugin list is refreshed.
    callback filter-menu-opened();
    /// Replaces the track's filters with the voice chain.
    callback filter-voice-preset(int);
    callback audio-mix-changed(bool);
    callback output-settings-changed();
    callback pick-output-folder();
    callback open-notice-file();
    callback play-notice-file();
    callback source-mode-changed(bool);
    callback select-game(int);
    callback allow-game();
    callback ignore-game();
    callback game-layer-changed(bool);

    // ---- Live stream ---------------------------------------------------
    in-out property <LiveService> live-service: LiveService.twitch;
    // Server URL of a custom service.
    in-out property <string> live-url;
    // Fit in a 16:9 box of this height; 0: the recording's size.
    in-out property <int> live-height: 1080;
    in-out property <int> live-fps: 60;
    // Mbit/s.
    in-out property <float> live-bitrate: 6;
    in-out property <VideoCodec> live-codec: VideoCodec.h264;
    // Where the stream key is kept ("" when there is none).
    in property <string> live-key-state;
    // Why the custom URL may send the key in clear ("" when it does not).
    in property <string> live-url-warning;
    in property <LiveState> live-state: LiveState.off;
    // On air for this long (across reconnections).
    in property <int> live-seconds;
    // "6.1 Mbit/s", or why it reconnects.
    in property <string> live-detail;
    in property <int> live-dropped;
    in property <string> live-shortcut: "Ctrl+L";
    callback toggle-live();
    callback live-settings-changed();
    callback live-key-entered(string);
    callback live-key-removed();

    // Background: "Start with the session" (autostart entry), and whether a
    // tray icon keeps Vesper running once the window is closed.
    // Profiles: the saved ones, the current one, and why a name was refused.
    in property <[ProfileEntry]> profiles;
    in property <string> profile-slug;
    in property <string> profile-name;
    in-out property <string> profile-error;
    callback profile-menu-opened();
    callback profile-switch(string);
    // A new profile with the default settings, a copy of the current one,
    // the current one renamed: true once done, else `profile-error` says why.
    callback profile-create(string) -> bool;
    callback profile-duplicate(string) -> bool;
    callback profile-rename(string) -> bool;
    // Deletes the current profile (never the last one).
    callback profile-delete();

    in-out property <bool> autostart;
    in property <bool> tray-available;
    callback autostart-changed(bool);
    callback quit();
    // Restarts the level meters, which stop while nothing moves them or the
    // window is hidden.
    callback meters-wake();
    // The tray mirrors these.
    callback tray-state-changed();
    changed rec-state => {
        root.tray-state-changed();
    }
    changed replay-enabled => {
        root.tray-state-changed();
    }
    changed live-state => {
        root.tray-state-changed();
    }

    property <string> codec-name: root.codec == VideoCodec.av1 ? "AV1" : root.codec == VideoCodec.hevc ? "HEVC" : "H.264";
    // The stream settings are locked unless it is off.
    property <bool> live-off: root.live-state == LiveState.off;
    property <bool> on-air: root.live-state == LiveState.live;
    property <string> live-service-name: root.live-service == LiveService.twitch ? "Twitch" : root.live-service == LiveService.youtube ? "YouTube" : "Custom server";
    property <int> live-m: Math.mod(Math.floor(root.live-seconds / 60), 60);
    property <int> live-s: Math.mod(root.live-seconds, 60);
    property <string> live-clock: "\{Math.floor(root.live-seconds / 3600)}:\{root.live-m < 10 ? "0" : ""}\{root.live-m}:\{root.live-s < 10 ? "0" : ""}\{root.live-s}";
    property <[int]> replay-options: [30, 60, 120];
    property <[int]> fps-options: [30, 60, 120, 144];
    // Showing the recording look (REC, stop square), including while stopping.
    property <bool> recording: root.rec-state == RecState.recording || root.rec-state == RecState.stopping;
    property <bool> busy: root.rec-state == RecState.starting || root.rec-state == RecState.stopping;
    // Anything but idle locks the source and output settings.
    property <bool> active: root.rec-state != RecState.idle;
    property <bool> game: root.source-kind == SourceKind.game;
    // Open and Play only while idle: during a recording the stats keep the row.
    property <bool> notice-actions: root.notice-has-file && root.notice != "" && !root.active;
    property <string> fps-text: (root.recording ? "\{Math.round(root.measured-fps * 10) / 10}" : "\{root.fps}") + " fps";
    // Audio card: the track whose settings are open (-1: none), and the picker.
    out property <int> open-track: -1;
    property <bool> picking;
    // The open track's "Add filter" menu is shown.
    property <bool> adding-filter;
    // Filter card to give keyboard focus to, and how (see FilterCard).
    property <int> filter-focus: -1;
    property <int> filter-focus-how;
    // A name being typed in the open track's field, not committed yet.
    property <string> name-draft;
    property <int> name-draft-track: -1;
    // The open track's Source list is shown.
    property <bool> choosing-source;
    // The settings' device list shown: 1 Desktop audio, 2 Microphone, 0 none.
    property <int> device-list;
    // The profile menu is shown, and what it shows: 0 the profiles, 1 a new
    // profile's name, 2 the copy's name, 3 the new name, 4 the delete
    // confirmation.
    property <bool> profile-menu;
    property <int> profile-mode;
    property <string> profile-draft;
    // Switching waits for the recording and the stream to end.
    property <bool> profiles-locked: root.active || !root.live-off;

    public function open-profile-menu(mode: int) {
        root.profile-menu = true;
        root.set-profile-mode(mode);
        root.profile-menu-opened();
    }

    function set-profile-mode(mode: int) {
        root.profile-mode = mode;
        root.profile-error = "";
        root.profile-draft = mode == 3 ? root.profile-name : mode == 2 ? root.profile-name + " copy" : "";
    }

    function close-profile-menu() {
        root.profile-menu = false;
        root.profile-mode = 0;
        profile-field.focus();
    }

    function submit-profile-name() {
        // New and Duplicate switch profiles: not while recording or streaming.
        if (root.profile-mode != 3 && root.profiles-locked) {
            return;
        }
        if (root.profile-mode == 1 ? root.profile-create(root.profile-draft) : root.profile-mode == 2 ? root.profile-duplicate(root.profile-draft) : root.profile-rename(root.profile-draft)) {
            root.close-profile-menu();
        }
    }

    // The tracks are shown anew: their settings close first.
    function switch-profile(slug: string) {
        root.close-track();
        root.picking = false;
        root.profile-switch(slug);
        root.close-profile-menu();
    }
    // A list of sources or devices is shown: the backend keeps them current.
    out property <bool> watching-sources: root.picking || root.choosing-source || root.settings-open;
    changed watching-sources => {
        root.sources-watch-changed(self.watching-sources);
    }

    // Closes the open track's settings; a name being typed is kept.
    function close-track() {
        if (root.name-draft-track >= 0) {
            root.track-renamed(root.name-draft-track, root.name-draft);
            root.name-draft-track = -1;
        }
        root.open-track = -1;
        root.adding-filter = false;
        root.choosing-source = false;
        root.filter-focus = -1;
    }

    function set-picking(on: bool) {
        root.close-track();
        root.picking = on;
    }

    public function open-track-settings(i: int) {
        root.close-track();
        root.picking = false;
        root.open-track = i;
    }

    // Opens the settings with a device list shown (see `device-list`).
    public function open-device-list(list: int) {
        root.settings-open = true;
        if (!root.active) {
            root.device-list = list;
        }
    }

    // Opens track `i`'s settings with its Source list shown.
    public function open-track-source(i: int) {
        if (!root.active) {
            root.open-track-settings(i);
            root.choosing-source = true;
        }
    }

    public function open-track-picker() {
        if (!root.active && root.tracks.length < root.max-tracks) {
            root.set-picking(true);
        }
    }

    // Adding and removing tracks waits for the recording to end.
    changed active => {
        if (root.active && root.picking) {
            root.set-picking(false);
        }
        if (root.active) {
            root.choosing-source = false;
            root.device-list = 0;
        }
    }

    title: "Vesper";
    preferred-width: 440px;
    preferred-height: 780px;
    min-width: 360px;
    min-height: 520px;
    background: Theme.window-bg;
    default-font-size: Theme.font-body;
    forward-focus: keys;

    // Same guards as the record button, so shortcuts cannot bypass them.
    function toggle-recording() {
        if (!root.settings-open) {
            root.global-toggle-recording();
        }
    }

    // Global shortcuts skip the settings-open guard: the window may be hidden
    // behind a game, and the settings apply as soon as they change.
    public function global-toggle-recording() {
        if (root.busy) {
            return;
        }
        if (root.recording) {
            root.stop-recording();
        } else {
            root.start-recording();
        }
    }

    // The tray's Replay buffer item: same path as the switch.
    public function toggle-replay() {
        root.replay-enabled = !root.replay-enabled;
        root.replay-changed(root.replay-enabled, root.replay-seconds);
    }

    function open-settings() {
        root.settings-open = true;
        root.profile-menu = false;
        if (root.active) {
            close-button.focus();
        } else {
            codec-picker.focus();
        }
    }

    // From the source card in game mode: straight to the layer switch.
    function open-game-settings() {
        root.settings-open = true;
        game-layer-switch.focus();
    }

    function close-settings() {
        root.settings-open = false;
        root.device-list = 0;
        settings-button.focus();
    }

    function request-save-replay() {
        if (!root.settings-open) {
            root.global-save-replay();
        }
    }

    public function global-save-replay() {
        if (root.replay-enabled) {
            root.save-replay();
        }
    }

    // Go live or end the stream (button, Ctrl+L, tray, global shortcut).
    public function global-toggle-live() {
        if (root.live-state != LiveState.ending) {
            root.toggle-live();
        }
    }

    keys := FocusScope {
        focus-on-tab-navigation: false;
        focus-on-click: false;

        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "r" || event.text == "R")) {
                root.toggle-recording();
                return accept;
            }
            if (event.modifiers.control && (event.text == "s" || event.text == "S")) {
                root.request-save-replay();
                return accept;
            }
            if (event.modifiers.control && (event.text == "l" || event.text == "L")) {
                if (!root.settings-open) {
                    root.global-toggle-live();
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "q" || event.text == "Q")) {
                root.quit();
                return accept;
            }
            if (event.modifiers.control && event.text == ",") {
                root.open-settings();
                return accept;
            }
            if (event.text == Key.Escape && root.settings-open) {
                root.close-settings();
                return accept;
            }
            reject
        }

        // Scrolls only when the window is shorter than the content.
        flick := Flickable {
            content-width: self.width;
            content-height: Math.max(self.height, main.min-height);
            interactive: self.content-height > self.height;
            main := VerticalLayout {
                width: flick.width;
                height: flick.content-height;
                padding: Theme.page-padding;
                padding-top: Theme.space-md;
                // The status line's 28px row centers its text: 6px more below.
                padding-bottom: Theme.space-sm;
                spacing: Theme.section-gap;

                // ---- Header ------------------------------------------------
                // Outside the cards, edges line up with the cards' outer edges.
                HorizontalLayout {
                    spacing: Theme.space-md;
                    alignment: stretch;
                    VerticalLayout {
                        alignment: center;
                        Logo { }
                    }
                    Text {
                        text: "Vesper";
                        vertical-alignment: center;
                        font-size: Theme.font-title;
                        font-weight: 700;
                        letter-spacing: 0.2px;
                        color: Theme.text;
                        horizontal-stretch: 1;
                    }
                    profile-field := SelectField {
                        min-width: 96px;
                        max-width: 200px;
                        horizontal-stretch: 0;
                        label: "Profile";
                        text: root.profile-name;
                        expanded: root.profile-menu;
                        enabled: !root.settings-open;
                        description: root.profiles-locked ? "Switching is locked while recording or streaming" : "";
                        clicked => {
                            if (root.profile-menu) {
                                root.close-profile-menu();
                            } else {
                                root.open-profile-menu(0);
                            }
                        }
                    }
                    settings-button := IconButton {
                        enabled: !root.settings-open;
                        icon: Icons.sliders;
                        label: "Output settings";
                        active: root.settings-open;
                        clicked => {
                            root.open-settings();
                        }
                    }
                }

                // ---- Profile menu ------------------------------------------
                if root.profile-menu: FocusScope {
                    focus-on-tab-navigation: false;
                    focus-on-click: false;
                    // Escape: back to the profiles, else the menu closes.
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            if (root.profile-mode != 0) {
                                root.set-profile-mode(0);
                            } else {
                                root.close-profile-menu();
                            }
                            return accept;
                        }
                        reject
                    }
                    Card {
                        VerticalLayout {
                            padding: Theme.space-sm;
                            spacing: Theme.space-xs;
                            VerticalLayout {
                                spacing: 2px;
                                accessible-role: list;
                                accessible-label: "Profiles";
                                for p in root.profiles: ProfileRow {
                                    name: p.name;
                                    selected: p.slug == root.profile-slug;
                                    enabled: !root.profiles-locked;
                                    take-focus: profile-field.keyboard && self.selected && root.profile-mode == 0;
                                    clicked => {
                                        if (p.slug == root.profile-slug) {
                                            root.close-profile-menu();
                                        } else {
                                            root.switch-profile(p.slug);
                                        }
                                    }
                                }
                            }
                            if root.profiles-locked: HorizontalLayout {
                                padding-left: Theme.space-sm;
                                padding-right: Theme.space-sm;
                                Text {
                                    text: "Switching is locked while recording or streaming.";
                                    font-size: Theme.font-small;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }
                            if root.profile-mode == 0: HorizontalLayout {
                                spacing: Theme.space-xs;
                                alignment: start;
                                Button {
                                    text: "New";
                                    small: true;
                                    kind: "ghost";
                                    enabled: !root.profiles-locked;
                                    accessible-label: "New profile";
                                    clicked => {
                                        root.set-profile-mode(1);
                                    }
                                }
                                Button {
                                    text: "Duplicate";
                                    small: true;
                                    kind: "ghost";
                                    enabled: !root.profiles-locked;
                                    accessible-label: "Duplicate \{root.profile-name}";
                                    clicked => {
                                        root.set-profile-mode(2);
                                    }
                                }
                                Button {
                                    text: "Rename";
                                    small: true;
                                    kind: "ghost";
                                    accessible-label: "Rename \{root.profile-name}";
                                    clicked => {
                                        root.set-profile-mode(3);
                                    }
                                }
                                Button {
                                    text: "Delete";
                                    small: true;
                                    kind: "ghost";
                                    // Never the last one.
                                    enabled: !root.profiles-locked && root.profiles.length > 1;
                                    accessible-label: "Delete \{root.profile-name}";
                                    accessible-description: root.profiles.length > 1 ? "" : "The last profile cannot be deleted";
                                    clicked => {
                                        root.set-profile-mode(4);
                                    }
                                }
                            }
                            if root.profile-mode >= 1 && root.profile-mode <= 3: VerticalLayout {
                                padding: Theme.space-sm;
                                spacing: Theme.space-sm;
                                Text {
                                    text: root.profile-mode == 1 ? "New profile, with the default settings" : root.profile-mode == 2 ? "Copy of “\{root.profile-name}”" : "Rename “\{root.profile-name}”";
                                    font-size: Theme.font-small;
                                    font-weight: 600;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                TextField {
                                    text: root.profile-draft;
                                    label: "Profile name";
                                    placeholder: "Profile name";
                                    enabled: root.profile-mode == 3 || !root.profiles-locked;
                                    init => {
                                        self.focus();
                                    }
                                    edited(text) => {
                                        root.profile-draft = text;
                                    }
                                    accepted(text) => {
                                        root.profile-draft = text;
                                        root.submit-profile-name();
                                    }
                                }
                                // Always there, so a new error is announced.
                                Text {
                                    max-height: root.profile-error == "" ? 0px : 1000px;
                                    text: root.profile-error;
                                    font-size: Theme.font-small;
                                    color: Theme.warn;
                                    wrap: word-wrap;
                                    accessible-role: text;
                                    accessible-live-region: AccessibleLiveness.assertive;
                                }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: Theme.space-sm;
                                    Button {
                                        text: "Cancel";
                                        small: true;
                                        kind: "ghost";
                                        clicked => {
                                            root.set-profile-mode(0);
                                        }
                                    }
                                    Button {
                                        text: root.profile-mode == 1 ? "Create" : root.profile-mode == 2 ? "Duplicate" : "Rename";
                                        small: true;
                                        kind: "primary";
                                        // A recording or stream that started meanwhile.
                                        enabled: root.profile-mode == 3 || !root.profiles-locked;
                                        clicked => {
                                            root.submit-profile-name();
                                        }
                                    }
                                }
                            }
                            if root.profile-mode == 4: VerticalLayout {
                                padding: Theme.space-sm;
                                spacing: Theme.space-sm;
                                Text {
                                    text: "Delete “\{root.profile-name}”? Its settings and plugin states are deleted.";
                                    font-size: Theme.font-small;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: Theme.space-sm;
                                    Button {
                                        text: "Cancel";
                                        small: true;
                                        kind: "ghost";
                                        init => {
                                            self.focus();
                                        }
                                        clicked => {
                                            root.set-profile-mode(0);
                                        }
                                    }
                                    Button {
                                        text: "Delete";
                                        small: true;
                                        kind: "danger";
                                        enabled: !root.profiles-locked;
                                        accessible-label: "Delete \{root.profile-name}";
                                        clicked => {
                                            root.profile-delete();
                                            root.close-profile-menu();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ---- Game consent ------------------------------------------
                if root.pending-game != "": Card {
                    border-color: Theme.accent;
                    accessible-role: groupbox;
                    accessible-label: "Allow Vesper to capture \{root.pending-game}?";
                    VerticalLayout {
                        padding: Theme.card-padding;
                        spacing: Theme.space-sm;
                        Text {
                            text: "Allow Vesper to capture \{root.pending-game}?";
                            font-size: Theme.font-body;
                            font-weight: 600;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "An app asks to be recorded. Allow only games you recognize.";
                            font-size: Theme.font-small;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: Theme.space-sm;
                            Button {
                                text: "Ignore";
                                kind: "ghost";
                                accessible-label: "Ignore \{root.pending-game}";
                                clicked => {
                                    root.ignore-game();
                                }
                            }
                            Button {
                                text: "Allow";
                                kind: "primary";
                                accessible-label: "Allow capturing \{root.pending-game}";
                                clicked => {
                                    root.allow-game();
                                }
                            }
                        }
                    }
                }

                // ---- Source ------------------------------------------------
                Card {
                    VerticalLayout {
                        padding: Theme.card-padding;
                        spacing: Theme.space-md;
                        HorizontalLayout {
                            spacing: Theme.space-md;
                            Rectangle {
                                width: Theme.control-height;
                                height: Theme.control-height;
                                border-radius: Theme.radius-md;
                                background: root.source-kind == SourceKind.none ? Theme.surface-raised : Theme.accent-soft;
                                Icon {
                                    data: root.game ? Icons.gamepad : root.source-kind == SourceKind.window ? Icons.window : Icons.monitor;
                                    tint: root.source-kind == SourceKind.none ? Theme.text-muted : Theme.accent;
                                }
                            }
                            Labeled {
                                horizontal-stretch: 1;
                                title: root.game
                                    ? (root.source-name != "" ? root.source-name : "Waiting for a game…")
                                    : root.source-kind == SourceKind.none ? "No source selected" : root.source-name;
                                subtitle: root.game
                                    ? (root.source-name != ""
                                        ? "Game" + (root.source-detail != "" ? " · " + root.source-detail : "")
                                        : root.game-layer-installed || root.pending-game != "" ? "Start a game" : root.game-layer-available ? "Turn on game capture in settings" : "Game capture layer not built")
                                    : root.source-kind == SourceKind.none
                                        ? "Pick a screen or a window to record"
                                        : root.source-detail != "" ? root.source-detail : root.source-kind == SourceKind.screen ? "Screen" : "Window";
                                accessible-role: text;
                                accessible-label: root.game
                                    ? (root.source-name != "" ? "Game: " + root.source-name : "Waiting for a game")
                                    : root.source-kind == SourceKind.none
                                        ? "No source selected"
                                        : "Source: " + self.title + ", " + self.subtitle;
                            }
                            // In game mode without the layer: the way to set it up.
                            if !root.game || !root.game-layer-installed: VerticalLayout {
                                alignment: center;
                                Button {
                                    text: root.game ? "Set up" : root.source-kind == SourceKind.none ? "Choose" : "Change";
                                    kind: root.game || root.source-kind == SourceKind.none ? "primary" : "secondary";
                                    enabled: !root.active && !root.settings-open;
                                    accessible-label: root.game ? "Open the game capture settings" : "Choose source";
                                    clicked => {
                                        if (root.game) {
                                            root.open-game-settings();
                                        } else {
                                            root.pick-source();
                                        }
                                    }
                                }
                            }
                        }
                        Segmented {
                            label: "Source type";
                            enabled: !root.active && !root.settings-open && root.live-off;
                            options: ["Screen or window", "Game"];
                            selected: root.game ? 1 : 0;
                            changed(i) => {
                                root.source-mode-changed(i == 1);
                            }
                        }
                        if root.game && root.other-games.length > 0: VerticalLayout {
                            spacing: Theme.space-xs;
                            Text {
                                text: "Also running";
                                font-size: Theme.font-caption;
                                font-weight: 600;
                                color: Theme.text-muted;
                            }
                            for g in root.other-games: HorizontalLayout {
                                spacing: Theme.space-sm;
                                Text {
                                    horizontal-stretch: 1;
                                    text: g.name;
                                    vertical-alignment: center;
                                    font-size: Theme.font-small;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                Button {
                                    text: "Capture";
                                    small: true;
                                    enabled: !root.settings-open;
                                    accessible-label: "Capture \{g.name}";
                                    clicked => {
                                        root.select-game(g.pid);
                                    }
                                }
                            }
                        }
                    }
                }

                // ---- Hero: record ------------------------------------------
                VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: Theme.space-sm;

                    // State pill
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px;
                            width: pill.preferred-width;
                            border-radius: 12px;
                            background: root.recording ? Theme.rec-soft : Theme.surface;
                            border-width: 1px;
                            border-color: root.recording ? transparent : Theme.border;
                            animate background, border-color { duration: Theme.medium; }
                            pill := HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.recording ? Theme.rec : Theme.text-faint;
                                        opacity: root.recording ? 0.35 + 0.65 * Math.abs(Math.sin(animation-tick() / 2s * 360deg)) : 1;
                                    }
                                }
                                Text {
                                    text: root.rec-state == RecState.starting ? "Starting" : root.rec-state == RecState.stopping ? "Saving" : root.recording ? "REC" : root.source-kind == SourceKind.none || (root.game && root.source-name == "") ? "No source" : "Ready";
                                    vertical-alignment: center;
                                    font-size: Theme.font-caption;
                                    font-weight: 700;
                                    letter-spacing: root.recording ? 1.2px : 0.3px;
                                    color: root.recording ? Theme.rec : Theme.text-muted;
                                }
                            }
                        }
                    }

                    Clock {
                        seconds: root.elapsed-seconds;
                        color: root.recording ? Theme.text : Theme.text-faint;
                        accessible-role: text;
                        accessible-label: "Elapsed time";
                    }

                    HorizontalLayout {
                        alignment: center;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        RecordButton {
                            enabled: !root.settings-open;
                            recording: root.recording;
                            busy: root.busy;
                            shortcut: root.record-shortcut;
                            toggle => {
                                root.toggle-recording();
                            }
                        }
                    }

                    Text {
                        text: root.rec-state == RecState.starting ? "Starting…" : root.rec-state == RecState.stopping ? "Finishing the file…" : root.recording ? "\{root.record-shortcut} to stop" : "\{root.record-shortcut} to start recording";
                        horizontal-alignment: center;
                        font-size: Theme.font-small;
                        color: Theme.text-faint;
                    }
                }

                // ---- Replay buffer -----------------------------------------
                Card {
                    VerticalLayout {
                        padding: Theme.space-lg;
                        spacing: Theme.space-md;
                        HorizontalLayout {
                            spacing: Theme.space-md;
                            Labeled {
                                horizontal-stretch: 1;
                                title: "Replay buffer";
                                subtitle: root.replay-enabled
                                    ? "Last \{root.replay-seconds < 60 ? root.replay-seconds + " s" : root.replay-seconds / 60 + " min"}, \{root.replay-memory}"
                                    : "Off. Turn on to save past moments";
                            }
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    enabled: !root.settings-open;
                                    label: "Replay buffer";
                                    checked: root.replay-enabled;
                                    toggled(on) => {
                                        root.replay-enabled = on;
                                        root.replay-changed(on, root.replay-seconds);
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-sm;
                            Segmented {
                                enabled: !root.settings-open;
                                horizontal-stretch: 1;
                                label: "Replay length";
                                options: ["30 s", "1 min", "2 min"];
                                selected: root.replay-seconds >= 120 ? 2 : root.replay-seconds >= 60 ? 1 : 0;
                                changed(i) => {
                                    root.replay-seconds = root.replay-options[i];
                                    root.replay-changed(root.replay-enabled, root.replay-seconds);
                                }
                            }
                            Button {
                                text: "Save replay";
                                icon: Icons.save;
                                enabled: root.replay-enabled && !root.settings-open;
                                accessible-label: "Save replay";
                                shortcut-hint: root.replay-shortcut;
                                clicked => {
                                    root.request-save-replay();
                                }
                            }
                        }
                    }
                }

                // ---- Live stream -------------------------------------------
                Card {
                    accessible-role: groupbox;
                    accessible-label: "Live stream";
                    HorizontalLayout {
                        padding: Theme.space-lg;
                        spacing: Theme.space-md;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            accessible-role: text;
                            accessible-label: live-title.text + ", " + live-subtitle.text;
                            HorizontalLayout {
                                alignment: start;
                                spacing: 6px;
                                if root.on-air: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: Theme.rec;
                                        opacity: 0.35 + 0.65 * Math.abs(Math.sin(animation-tick() / 2s * 360deg));
                                    }
                                }
                                live-title := Text {
                                    text: root.live-state == LiveState.connecting ? "Connecting…"
                                        : root.live-state == LiveState.reconnecting ? "Reconnecting…"
                                        : root.live-state == LiveState.ending ? "Ending the stream…"
                                        : root.on-air ? "LIVE" : "Live stream";
                                    font-size: Theme.font-body;
                                    font-weight: root.on-air ? 700 : 600;
                                    letter-spacing: root.on-air ? 1.2px : 0px;
                                    color: root.on-air ? Theme.rec : root.live-state == LiveState.reconnecting ? Theme.warn : Theme.text;
                                    vertical-alignment: center;
                                }
                                if root.on-air: Text {
                                    text: root.live-clock;
                                    font-size: Theme.font-body;
                                    font-weight: 600;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                            }
                            live-subtitle := Text {
                                text: root.live-off
                                    ? root.live-service-name + " · " + (root.live-height == 0 ? "native size" : root.live-height + "p") + root.live-fps + " · " + root.live-bitrate + " Mbit/s"
                                    : root.on-air
                                        ? root.live-detail + " · " + (root.live-dropped == 1 ? "1 dropped" : "\{root.live-dropped} dropped")
                                        : root.live-detail != "" ? root.live-detail : "to " + root.live-service-name;
                                font-size: Theme.font-small;
                                color: root.on-air && root.live-dropped > 0 ? Theme.warn : Theme.text-muted;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: root.live-off ? "Go live" : "End stream";
                                icon: root.live-off ? Icons.broadcast : "";
                                kind: "secondary";
                                enabled: !root.settings-open && root.live-state != LiveState.ending;
                                accessible-label: root.live-off ? "Go live on " + root.live-service-name : "End the live stream";
                                shortcut-hint: root.live-shortcut;
                                clicked => {
                                    root.global-toggle-live();
                                }
                            }
                        }
                    }
                }

                // ---- Audio -------------------------------------------------
                Card {
                    // The mute glyphs line up with the label: their 40px hit
                    // areas reach into the card padding.
                    VerticalLayout {
                        padding-top: Theme.card-padding;
                        padding-bottom: Theme.space-sm;
                        padding-left: Theme.space-xs;
                        padding-right: Theme.card-padding;
                        spacing: Theme.space-xs;
                        HorizontalLayout {
                            padding-left: Theme.card-padding - Theme.space-xs;
                            spacing: Theme.space-sm;
                            SectionLabel {
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                text: "AUDIO";
                            }
                            if !root.picking: Button {
                                text: "Add track";
                                icon: Icons.plus;
                                kind: "ghost";
                                small: true;
                                enabled: !root.active && !root.settings-open && root.tracks.length < root.max-tracks;
                                accessible-description: root.active ? "Locked while recording" : root.tracks.length >= root.max-tracks ? "At most \{root.max-tracks} tracks" : "";
                                clicked => {
                                    root.set-picking(true);
                                }
                            }
                            if root.picking: Button {
                                text: "Cancel";
                                kind: "ghost";
                                small: true;
                                accessible-label: "Close the source list";
                                clicked => {
                                    root.set-picking(false);
                                }
                            }
                        }
                        if root.tracks.length == 0 && !root.picking: HorizontalLayout {
                            padding-left: Theme.card-padding - Theme.space-xs;
                            Text {
                                height: Theme.control-height;
                                text: "No audio is recorded.";
                                vertical-alignment: center;
                                font-size: Theme.font-small;
                                color: Theme.text-muted;
                            }
                        }
                        for track[i] in root.tracks: VerticalLayout {
                            spacing: Theme.space-xs;
                            AudioRow {
                                interactive: !root.settings-open;
                                track: track;
                                level: root.track-levels[i];
                                peak: root.track-peaks[i];
                                open: root.open-track == i;
                                toggle-mute => {
                                    root.track-mute-toggled(i);
                                }
                                toggle-open => {
                                    let was-open = root.open-track == i;
                                    root.close-track();
                                    if (root.picking) {
                                        root.set-picking(false);
                                    }
                                    root.open-track = was-open ? -1 : i;
                                }
                            }
                            // Settings of the open track, under its name.
                            if root.open-track == i: VerticalLayout {
                                padding-left: Theme.control-height + Theme.space-md;
                                padding-bottom: Theme.space-sm;
                                spacing: Theme.space-sm;
                                accessible-role: groupbox;
                                accessible-label: "Settings of \{track.name}";
                                TextField {
                                    text: track.name;
                                    label: "Track name";
                                    enabled: !root.active;
                                    accepted(name) => {
                                        root.name-draft-track = -1;
                                        root.track-renamed(i, name);
                                    }
                                    edited(name) => {
                                        root.name-draft = name;
                                        root.name-draft-track = name != track.name ? i : -1;
                                    }
                                }
                                // What it records: same choices as "Add track".
                                HorizontalLayout {
                                    spacing: Theme.space-md;
                                    Text {
                                        width: 52px;
                                        text: "Source";
                                        vertical-alignment: center;
                                        font-size: Theme.font-small;
                                        color: Theme.text-muted;
                                    }
                                    source-field := SelectField {
                                        horizontal-stretch: 1;
                                        label: "Source of \{track.name}";
                                        text: track.source-label;
                                        icon: TrackText.icon(track.kind, false);
                                        expanded: root.choosing-source;
                                        enabled: !root.active;
                                        description: root.active ? "Locked while recording" : "";
                                        clicked => {
                                            root.adding-filter = false;
                                            root.choosing-source = !root.choosing-source;
                                        }
                                    }
                                }
                                if root.active: Text {
                                    text: "Source, name and recording are locked while recording.";
                                    font-size: Theme.font-small;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                                if root.choosing-source: SourceList {
                                    options: root.source-options;
                                    focus-current: source-field.keyboard;
                                    choosing: true;
                                    current: track.source;
                                    label: "Sources for \{track.name}";
                                    picked(option) => {
                                        root.choosing-source = false;
                                        source-field.focus();
                                        root.track-source-changed(i, option);
                                    }
                                    cancel => {
                                        root.choosing-source = false;
                                        source-field.focus();
                                    }
                                }
                                HorizontalLayout {
                                    spacing: Theme.space-md;
                                    Slider {
                                        horizontal-stretch: 1;
                                        label: "Volume of \{track.name}";
                                        minimum: -60;
                                        maximum: 12;
                                        step: 1;
                                        page-step: 6;
                                        value: track.volume-db;
                                        value-text: TrackText.volume(track.volume-db);
                                        changed(db) => {
                                            root.track-volume-changed(i, db);
                                        }
                                    }
                                    Text {
                                        width: 52px;
                                        text: TrackText.volume(track.volume-db);
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        font-size: Theme.font-small;
                                        color: Theme.text-muted;
                                    }
                                }
                                // Filters: live, even while recording.
                                HorizontalLayout {
                                    spacing: Theme.space-xs;
                                    padding-top: Theme.space-xs;
                                    SectionLabel {
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        text: "FILTERS";
                                    }
                                    if track.kind == TrackKind.microphone || track.kind == TrackKind.input: Button {
                                        text: "Voice preset";
                                        kind: "ghost";
                                        small: true;
                                        accessible-description: "Replaces the filters with high-pass, noise suppression, expander, compressor, de-esser and limiter";
                                        clicked => {
                                            root.adding-filter = false;
                                            root.filter-voice-preset(i);
                                        }
                                    }
                                    Button {
                                        text: root.adding-filter ? "Cancel" : "Add filter";
                                        icon: root.adding-filter ? "" : Icons.plus;
                                        kind: "ghost";
                                        small: true;
                                        enabled: root.adding-filter || track.filters.length < root.max-filters;
                                        accessible-label: root.adding-filter ? "Close the filter list" : "Add filter";
                                        clicked => {
                                            root.adding-filter = !root.adding-filter;
                                            if (root.adding-filter) {
                                                root.filter-menu-opened();
                                            }
                                        }
                                    }
                                }
                                if root.adding-filter: VerticalLayout {
                                    spacing: 2px;
                                    accessible-role: list;
                                    accessible-label: "Filters";
                                    for kind in root.filter-kinds: MenuRow {
                                        text: kind.title;
                                        label: "Add \{kind.title}";
                                        clicked => {
                                            root.adding-filter = false;
                                            root.filter-added(i, kind.kind);
                                        }
                                    }
                                }
                                if track.filters.length == 0 && !root.adding-filter: Text {
                                    text: "No filter: the track is recorded as is.";
                                    font-size: Theme.font-small;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                                for filter[j] in track.filters: FilterCard {
                                    filter: filter;
                                    reduction: root.filter-reductions[j];
                                    first: j == 0;
                                    last: j == track.filters.length - 1;
                                    take-focus: root.filter-focus == j ? root.filter-focus-how : 0;
                                    toggled(on) => {
                                        root.filter-toggled(i, j, on);
                                    }
                                    param-changed(k, v) => {
                                        root.filter-param-changed(i, j, k, v);
                                    }
                                    move(d) => {
                                        root.filter-moved(i, j, d);
                                        root.filter-focus-how = d;
                                        root.filter-focus = j + d;
                                    }
                                    remove => {
                                        root.filter-removed(i, j);
                                        root.filter-focus-how = 2;
                                        root.filter-focus = Math.min(j, track.filters.length - 1);
                                    }
                                }
                                HorizontalLayout {
                                    spacing: Theme.space-sm;
                                    VerticalLayout {
                                        alignment: center;
                                        Switch {
                                            label: "Record \{track.name}";
                                            enabled: !root.active;
                                            checked: track.enabled;
                                            toggled(on) => {
                                                root.track-enabled-changed(i, on);
                                            }
                                        }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Recorded";
                                        vertical-alignment: center;
                                        font-size: Theme.font-small;
                                        color: Theme.text-muted;
                                    }
                                    Button {
                                        text: "Remove";
                                        kind: "ghost";
                                        small: true;
                                        enabled: !root.active;
                                        accessible-label: "Remove \{track.name}";
                                        clicked => {
                                            // Its name no longer matters.
                                            root.name-draft-track = -1;
                                            root.close-track();
                                            root.track-removed(i);
                                        }
                                    }
                                }
                            }
                        }
                        // The source picker: one tap adds a track.
                        if root.picking: VerticalLayout {
                            padding-left: Theme.card-padding - Theme.space-xs - Theme.space-sm;
                            padding-bottom: Theme.space-xs;
                            spacing: 2px;
                            SourceList {
                                options: root.source-options;
                                label: "Sources";
                                picked(option) => {
                                    root.set-picking(false);
                                    root.track-added(option);
                                }
                                cancel => {
                                    root.set-picking(false);
                                }
                            }
                            if !root.apps-playing: HorizontalLayout {
                                padding-left: Theme.space-sm;
                                padding-top: Theme.space-xs;
                                Text {
                                    text: "Applications show up here while they play audio.";
                                    font-size: Theme.font-small;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // ---- Status line -------------------------------------------
                // Fixed height, so a notice with buttons moves nothing. While
                // recording the stats stay: a notice is text only, between them.
                HorizontalLayout {
                    height: 28px;
                    spacing: Theme.space-sm;
                    if !root.notice-actions: Text {
                        horizontal-stretch: 1;
                        // With a notice beside it, the fps goes first so elision spares it.
                        text: root.active && root.notice != ""
                            ? root.fps-text
                            : root.encoder + " " + root.codec-name + (root.resolution != "" ? "   ·   " + root.resolution : "") + "   ·   " + root.fps-text;
                        vertical-alignment: center;
                        font-size: Theme.font-small;
                        color: Theme.text-faint;
                        overflow: elide;
                        accessible-role: text;
                    }
                    if root.notice != "" && !root.notice-actions: HorizontalLayout {
                        spacing: 6px;
                        if root.notice-has-file: Icon {
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            data: Icons.check;
                            stroke: 2.25px;
                            tint: Theme.accent;
                        }
                        Text {
                            text: root.notice;
                            vertical-alignment: center;
                            font-size: Theme.font-small;
                            font-weight: 600;
                            color: Theme.accent;
                            overflow: elide;
                        }
                    }
                    if (root.notice == "" || root.active) && !root.notice-actions: Text {
                        text: root.dropped-frames == 1 ? "1 dropped" : "\{root.dropped-frames} dropped";
                        vertical-alignment: center;
                        font-size: Theme.font-small;
                        font-weight: root.dropped-frames > 0 ? 600 : 400;
                        color: root.dropped-frames > 0 ? Theme.warn : Theme.text-faint;
                    }
                    // A saved file while idle: what happened, and what to do with it.
                    if root.notice-actions: HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        accessible-role: text;
                        accessible-label: root.notice;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            data: Icons.check;
                            stroke: 2.25px;
                            tint: Theme.accent;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.notice;
                            vertical-alignment: center;
                            font-size: Theme.font-small;
                            font-weight: 600;
                            color: Theme.accent;
                            overflow: elide;
                        }
                    }
                    if root.notice-actions: Button {
                        text: "Open";
                        kind: "ghost";
                        small: true;
                        accessible-label: "Show the file in its folder";
                        clicked => {
                            root.open-notice-file();
                        }
                    }
                    if root.notice-actions: Button {
                        text: "Play";
                        kind: "ghost";
                        small: true;
                        accessible-label: "Play the file";
                        clicked => {
                            root.play-notice-file();
                        }
                    }
                }
            }
        }

        // Hints that more content is below when the window is very short.
        Rectangle {
            y: parent.height - self.height;
            height: 40px;
            visible: flick.interactive && -flick.content-y < flick.content-height - flick.height - 1px;
            background: @linear-gradient(180deg, Theme.window-bg.transparentize(1) 0%, Theme.window-bg 100%);
        }

        // ---- Settings drawer --------------------------------------------
        scrim := Rectangle {
            visible: self.opacity > 0.01;
            background: Theme.scrim;
            opacity: root.settings-open ? 1 : 0;
            animate opacity { duration: Theme.medium; }
            TouchArea {
                enabled: root.settings-open;
                clicked => {
                    root.close-settings();
                }
            }
        }

        drawer := Rectangle {
            width: Math.min(parent.width - 32px, 380px);
            x: root.settings-open ? parent.width - self.width : parent.width + 24px;
            visible: root.settings-open || self.x < parent.width;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000055;
            animate x { duration: Theme.medium; easing: ease-out-quart; }
            accessible-role: groupbox;
            accessible-label: "Output settings";

            // Swallow clicks so they do not reach the scrim.
            TouchArea { }

            // Scrolls only when the window is shorter than the settings.
            drawer-flick := Flickable {
                content-width: self.width;
                content-height: Math.max(self.height, drawer-body.min-height);
                interactive: self.content-height > self.height;
                drawer-body := VerticalLayout {
                    width: drawer-flick.width;
                    height: drawer-flick.content-height;
                    padding: Theme.page-padding;
                    padding-top: Theme.space-md;
                    spacing: Theme.space-xl;

                    HorizontalLayout {
                        Text {
                            horizontal-stretch: 1;
                            text: "Output";
                            vertical-alignment: center;
                            font-size: Theme.font-title;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        close-button := IconButton {
                            icon: Icons.close;
                            label: "Close settings";
                            clicked => {
                                root.close-settings();
                            }
                        }
                    }

                    if root.active: Rectangle {
                        border-radius: Theme.radius-md;
                        background: Theme.rec-soft;
                        height: 36px;
                        Text {
                            text: "Locked while recording";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: Theme.font-small;
                            font-weight: 600;
                            color: Theme.rec;
                        }
                    }

                    SettingGroup {
                        label: "CODEC";
                        hint: root.codec == VideoCodec.av1
                            ? "Smallest files at a given quality. Needs a recent player."
                            : root.codec == VideoCodec.hevc ? "Efficient and widely supported by hardware." : "Plays everywhere, larger files.";
                        codec-picker := Segmented {
                            label: "Codec";
                            enabled: !root.active;
                            options: ["AV1", "HEVC", "H.264"];
                            selected: root.codec == VideoCodec.av1 ? 0 : root.codec == VideoCodec.hevc ? 1 : 2;
                            changed(i) => {
                                root.codec = i == 0 ? VideoCodec.av1 : i == 1 ? VideoCodec.hevc : VideoCodec.h264;
                                root.output-settings-changed();
                            }
                        }
                    }

                    SettingGroup {
                        label: "QUALITY";
                        Segmented {
                            label: "Quality preset";
                            enabled: !root.active;
                            options: ["Performance", "Balanced", "Quality"];
                            selected: root.quality == QualityPreset.performance ? 0 : root.quality == QualityPreset.balanced ? 1 : 2;
                            changed(i) => {
                                root.quality = i == 0 ? QualityPreset.performance : i == 1 ? QualityPreset.balanced : QualityPreset.quality;
                                root.output-settings-changed();
                            }
                        }
                    }

                    SettingGroup {
                        label: "FRAME RATE";
                        Segmented {
                            label: "Frame rate";
                            enabled: !root.active;
                            options: ["30", "60", "120", "144"];
                            selected: root.fps >= 144 ? 3 : root.fps >= 120 ? 2 : root.fps >= 60 ? 1 : 0;
                            changed(i) => {
                                root.fps = root.fps-options[i];
                                root.output-settings-changed();
                            }
                        }
                    }

                    SettingGroup {
                        label: "AUDIO DEVICES";
                        hint: "Recorded by the Desktop audio and Microphone tracks. An unplugged device is waited for, never replaced by another one.";
                        VerticalLayout {
                            spacing: Theme.space-md;
                            DevicePicker {
                                title: "Desktop audio";
                                choice: root.desktop-device;
                                options: root.desktop-device-options;
                                default-source: "desktop";
                                locked: root.active;
                                open: root.device-list == 1;
                                opened(on) => {
                                    root.device-list = on ? 1 : 0;
                                }
                                chosen(option) => {
                                    root.device-chosen(false, option);
                                }
                            }
                            DevicePicker {
                                title: "Microphone";
                                choice: root.mic-device;
                                options: root.mic-device-options;
                                default-source: "microphone";
                                locked: root.active;
                                open: root.device-list == 2;
                                opened(on) => {
                                    root.device-list = on ? 2 : 0;
                                }
                                chosen(option) => {
                                    root.device-chosen(true, option);
                                }
                            }
                        }
                    }

                    SettingGroup {
                        label: "AUDIO";
                        hint: "Each track is saved separately, for editing. The mix comes first, so players that play one track play everything.";
                        HorizontalLayout {
                            spacing: Theme.space-md;
                            Labeled {
                                horizontal-stretch: 1;
                                title: "Mix of all tracks";
                                subtitle: "Added when two or more tracks record";
                            }
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    label: "Mix of all tracks";
                                    enabled: !root.active;
                                    checked: root.audio-mix;
                                    toggled(on) => {
                                        root.audio-mix = on;
                                        root.audio-mix-changed(on);
                                    }
                                }
                            }
                        }
                    }

                    SettingGroup {
                        label: "LIVE STREAM";
                        hint: root.live-service == LiveService.twitch
                            ? "Sent to Twitch's automatic ingest over RTMPS, in H.264: the codec Twitch takes."
                            : root.live-service == LiveService.youtube
                                ? "Sent to YouTube over RTMPS. HEVC and AV1 go through Enhanced RTMP."
                                : "An rtmp://, rtmps:// or srt:// server. The key ends the RTMP path, or is the SRT streamid." + (root.live-url-warning != "" ? " " + root.live-url-warning : "");
                        VerticalLayout {
                            spacing: Theme.space-md;
                            Segmented {
                                label: "Streaming service";
                                enabled: root.live-off;
                                options: ["Twitch", "YouTube", "Custom"];
                                selected: root.live-service == LiveService.twitch ? 0 : root.live-service == LiveService.youtube ? 1 : 2;
                                changed(i) => {
                                    root.live-service = i == 0 ? LiveService.twitch : i == 1 ? LiveService.youtube : LiveService.custom;
                                    root.live-settings-changed();
                                }
                            }
                            if root.live-service == LiveService.custom: Field {
                                title: "Server URL";
                                TextField {
                                    text: root.live-url;
                                    label: "Server URL";
                                    placeholder: "rtmp://host/app or srt://host:port";
                                    enabled: root.live-off;
                                    accepted(url) => {
                                        root.live-url = url;
                                        root.live-settings-changed();
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-md;
                                Labeled {
                                    horizontal-stretch: 1;
                                    title: "Stream key";
                                    subtitle: root.live-key-state != "" ? root.live-key-state : "Not set";
                                }
                                if root.live-key-state != "": VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Remove";
                                        kind: "ghost";
                                        small: true;
                                        enabled: root.live-off;
                                        accessible-label: "Remove the stream key";
                                        clicked => {
                                            root.live-key-removed();
                                        }
                                    }
                                }
                            }
                            TextField {
                                label: "New stream key";
                                password: true;
                                placeholder: root.live-key-state != "" ? "Paste a new key to replace it" : "Paste the key, then press Enter";
                                enabled: root.live-off;
                                accepted(key) => {
                                    root.live-key-entered(key);
                                }
                            }
                            Field {
                                title: "Resolution";
                                Segmented {
                                    label: "Stream resolution";
                                    enabled: root.live-off;
                                    options: ["Native", "1080p", "720p"];
                                    selected: root.live-height == 0 ? 0 : root.live-height >= 1080 ? 1 : 2;
                                    changed(i) => {
                                        root.live-height = i == 0 ? 0 : i == 1 ? 1080 : 720;
                                        root.live-settings-changed();
                                    }
                                }
                            }
                            Field {
                                title: "Frame rate";
                                Segmented {
                                    label: "Stream frame rate";
                                    enabled: root.live-off;
                                    options: ["30", "60"];
                                    selected: root.live-fps >= 60 ? 1 : 0;
                                    changed(i) => {
                                        root.live-fps = i == 0 ? 30 : 60;
                                        root.live-settings-changed();
                                    }
                                }
                            }
                            Field {
                                title: "Bitrate";
                                HorizontalLayout {
                                    spacing: Theme.space-md;
                                    Slider {
                                        horizontal-stretch: 1;
                                        label: "Stream bitrate";
                                        enabled: root.live-off;
                                        minimum: 1;
                                        maximum: 20;
                                        step: 0.5;
                                        page-step: 2;
                                        default-value: 6;
                                        value: root.live-bitrate;
                                        value-text: "\{root.live-bitrate} Mbit/s";
                                        changed(v) => {
                                            root.live-bitrate = v;
                                            root.live-settings-changed();
                                        }
                                    }
                                    Text {
                                        width: 76px;
                                        text: "\{root.live-bitrate} Mbit/s";
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        font-size: Theme.font-small;
                                        color: Theme.text-muted;
                                    }
                                }
                            }
                            Field {
                                title: "Encoder";
                                Segmented {
                                    label: "Stream codec";
                                    enabled: root.live-off && root.live-service != LiveService.twitch;
                                    options: ["H.264", "HEVC", "AV1"];
                                    selected: root.live-service == LiveService.twitch || root.live-codec == VideoCodec.h264 ? 0 : root.live-codec == VideoCodec.hevc ? 1 : 2;
                                    changed(i) => {
                                        root.live-codec = i == 0 ? VideoCodec.h264 : i == 1 ? VideoCodec.hevc : VideoCodec.av1;
                                        root.live-settings-changed();
                                    }
                                }
                            }
                        }
                    }

                    SettingGroup {
                        label: "GAME CAPTURE";
                        hint: "Records Vulkan games (Proton and 32-bit included) at their own frame rate, without the screen picker. Installs a small layer that loads into your Vulkan apps and stays idle until Vesper captures a game you allowed. Some anti-cheats may reject it: launch those games with VESPER_CAPTURE_DISABLE=1.";
                        HorizontalLayout {
                            spacing: Theme.space-md;
                            Labeled {
                                horizontal-stretch: 1;
                                title: "Game capture (Vulkan layer)";
                                wrap-subtitle: true;
                                subtitle: root.game-layer-outdated
                                    ? "Update available"
                                    : root.game-layer-installed ? "Installed for this user" : root.game-layer-available ? "Not installed" : "Layer not built: install the Vesper package or build the workspace";
                            }
                            if root.game-layer-outdated: VerticalLayout {
                                alignment: center;
                                Button {
                                    text: "Update";
                                    accessible-label: "Update the game capture layer";
                                    clicked => {
                                        root.game-layer-changed(true);
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                game-layer-switch := Switch {
                                    label: "Game capture (Vulkan layer)";
                                    enabled: root.game-layer-installed || root.game-layer-available;
                                    checked: root.game-layer-installed;
                                    toggled(on) => {
                                        root.game-layer-changed(on);
                                    }
                                }
                            }
                        }
                    }

                    SettingGroup {
                        label: "OPENGL GAMES";
                        hint: "For the best performance in OpenGL games (Terraria, many indie games, emulators), add vesper-gl %command% to the game's launch options in Steam (Properties > General); otherwise Vesper captures the game window. Only that game loads the capture library, with the same consent as Vulkan games. Don't use it on multiplayer games protected by VAC, EAC or BattlEye: risk of an account ban.";
                        Labeled {
                            title: "vesper-gl %command%";
                            wrap-subtitle: true;
                            subtitle: "Steam launch options";
                        }
                    }

                    SettingGroup {
                        label: "OUTPUT FOLDER";
                        HorizontalLayout {
                            spacing: Theme.space-sm;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: Theme.control-height;
                                border-radius: Theme.radius-md;
                                background: Theme.surface-raised;
                                HorizontalLayout {
                                    padding-left: Theme.space-md;
                                    padding-right: Theme.space-md;
                                    spacing: Theme.space-sm;
                                    Icon {
                                        y: (parent.height - self.height) / 2;
                                        width: 18px;
                                        height: 18px;
                                        data: Icons.folder;
                                        tint: Theme.text-muted;
                                    }
                                    // The name stays whole; a long path elides.
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        accessible-role: text;
                                        accessible-label: "Output folder: " + (root.output-folder != "" ? root.output-folder : "none");
                                        Text {
                                            text: root.output-folder != "" ? root.output-folder-name : "No folder chosen";
                                            font-size: Theme.font-small;
                                            font-weight: root.output-folder != "" ? 600 : 400;
                                            color: root.output-folder != "" ? Theme.text : Theme.text-muted;
                                            overflow: elide;
                                        }
                                        if root.output-folder-parent != "": Text {
                                            text: root.output-folder-parent;
                                            font-size: Theme.font-caption;
                                            color: Theme.text-muted;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                            Button {
                                text: root.output-folder != "" ? "Change" : "Choose";
                                kind: root.output-folder != "" ? "secondary" : "primary";
                                enabled: !root.active;
                                accessible-label: "Choose output folder";
                                clicked => {
                                    root.pick-output-folder();
                                }
                            }
                        }
                    }

                    SettingGroup {
                        label: "BACKGROUND";
                        hint: root.tray-available
                            ? "Closing the window keeps Vesper in the tray, with the replay buffer running. Quit from the tray menu or with Ctrl+Q."
                            : "No system tray found: closing the window quits Vesper.";
                        HorizontalLayout {
                            spacing: Theme.space-md;
                            Labeled {
                                horizontal-stretch: 1;
                                title: "Start with the session";
                                subtitle: "Starts hidden in the tray";
                            }
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    label: "Start with the session";
                                    checked: root.autostart;
                                    toggled(on) => {
                                        root.autostart-changed(on);
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    Text {
                        text: "Saved as MKV, which stays readable even if the app crashes.";
                        font-size: Theme.font-small;
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
