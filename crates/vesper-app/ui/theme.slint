// Design tokens. One accent (violet, "vesper"), plus a semantic recording red.
// Colors follow the system color scheme; `Theme.scheme` can be overridden from Rust.

import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <ColorScheme> scheme: Palette.color-scheme;
    out property <bool> dark: scheme != ColorScheme.light;

    // Surfaces
    out property <color> window-bg: dark ? #0E0F13 : #F3F3F6;
    out property <color> surface: dark ? #17181D : #FFFFFF;
    out property <color> surface-raised: dark ? #1F2027 : #F1F1F5;
    out property <color> surface-hover: dark ? #262730 : #E9E9EE;
    out property <color> surface-pressed: dark ? #2E2F39 : #E1E1E7;
    out property <color> border: dark ? #24252D : #E4E4EA;
    out property <color> border-strong: dark ? #34353F : #D0D0D8;
    // Edges of the controls one types in or picks from (fields, selectors,
    // a switch's off track): at least 3:1 on `surface` and `surface-raised`.
    out property <color> control-border: dark ? #6A6C76 : #898B95;
    out property <color> scrim: dark ? #000000a0 : #16171c50;

    // Text (AA on `surface` and `window-bg` in both schemes)
    out property <color> text: dark ? #ECECF1 : #16171C;
    out property <color> text-muted: dark ? #A1A3B0 : #5B5D6A;
    out property <color> text-faint: dark ? #80838F : #696C7A;

    // Accent
    out property <color> accent: dark ? #9A8CFF : #5847D6;
    out property <color> accent-hover: dark ? #AA9EFF : #4C3BC9;
    out property <color> on-accent: dark ? #0E0F13 : #FFFFFF;
    out property <color> accent-soft: dark ? #9A8CFF24 : #5847D617;

    // Recording state (semantic, never decorative)
    out property <color> rec: dark ? #FF5C52 : #D23A30;
    out property <color> rec-soft: dark ? #FF5C5226 : #D23A301a;
    // Red text on `rec-soft` (the REC pill, 11px bold): 4.5:1 at least
    // (light: 4.6:1 on the tinted window background, where `rec` is 3.75:1).
    out property <color> rec-text: dark ? #FF5C52 : #B92F26;
    out property <color> warn: dark ? #F2B84B : #9A6200;

    // Meter
    out property <color> meter-track: dark ? #23242C : #E9E9EE;
    out property <color> meter-hot: dark ? #F2B84B : #D08A00;
    // Level meter zones: below -12 dBFS, -12 to -3, above -3. Lit, each at
    // least 3:1 on `meter-track` and `surface`; unlit, the same at `meter-unlit`.
    out property <color> meter-low: dark ? #5BD08A : #188A4A;
    out property <color> meter-mid: dark ? #F2B84B : #B07400;
    out property <color> meter-high: dark ? #FF5C52 : #D23A30;
    out property <float> meter-unlit: dark ? 0.2 : 0.22;

    // Metrics
    out property <length> radius-sm: 8px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 16px;
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
    out property <length> control-height: 40px;
    out property <length> control-height-sm: 28px;
    out property <length> segmented-height: 36px;
    // Outer margin of the window and the settings drawer.
    out property <length> page-padding: 20px;
    // Inner padding of every card: content edges line up across cards.
    out property <length> card-padding: 16px;
    // Between top-level blocks (cards, setting groups).
    out property <length> section-gap: 16px;

    // Type scale
    out property <length> font-caption: 11px;
    out property <length> font-small: 12px;
    out property <length> font-body: 13px;
    out property <length> font-title: 15px;
    out property <length> font-display: 42px;

    out property <duration> fast: 120ms;
    out property <duration> medium: 240ms;
}

// SVG path data, 24x24 viewbox, meant to be stroked.
export global Icons {
    out property <string> monitor: "M4 4.5 L20 4.5 A1.5 1.5 0 0 1 21.5 6 L21.5 15.5 A1.5 1.5 0 0 1 20 17 L4 17 A1.5 1.5 0 0 1 2.5 15.5 L2.5 6 A1.5 1.5 0 0 1 4 4.5 Z M8 20.5 L16 20.5 M12 17 L12 20.5";
    out property <string> window: "M4 4 L20 4 A1.5 1.5 0 0 1 21.5 5.5 L21.5 18.5 A1.5 1.5 0 0 1 20 20 L4 20 A1.5 1.5 0 0 1 2.5 18.5 L2.5 5.5 A1.5 1.5 0 0 1 4 4 Z M2.5 8.5 L21.5 8.5";
