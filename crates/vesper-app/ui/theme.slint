    out property <string> mic: "M12 3 A3 3 0 0 1 15 6 L15 11.5 A3 3 0 0 1 9 11.5 L9 6 A3 3 0 0 1 12 3 Z M18.5 11 A6.5 6.5 0 0 1 5.5 11 M12 17.5 L12 21";
    out property <string> mic-off: "M12 3 A3 3 0 0 1 15 6 L15 11.5 A3 3 0 0 1 9 11.5 L9 6 A3 3 0 0 1 12 3 Z M18.5 11 A6.5 6.5 0 0 1 5.5 11 M12 17.5 L12 21 M3.5 3.5 L20.5 20.5";
    out property <string> app: "M4 4 L20 4 A1.5 1.5 0 0 1 21.5 5.5 L21.5 18.5 A1.5 1.5 0 0 1 20 20 L4 20 A1.5 1.5 0 0 1 2.5 18.5 L2.5 5.5 A1.5 1.5 0 0 1 4 4 Z M2.5 8.5 L21.5 8.5 M10 11.5 L10 16.5 M7.5 13 L7.5 15 M12.5 13 L12.5 15 M15 12.5 L15 15.5";
    out property <string> app-off: "M4 4 L20 4 A1.5 1.5 0 0 1 21.5 5.5 L21.5 18.5 A1.5 1.5 0 0 1 20 20 L4 20 A1.5 1.5 0 0 1 2.5 18.5 L2.5 5.5 A1.5 1.5 0 0 1 4 4 Z M2.5 8.5 L21.5 8.5 M3.5 3.5 L20.5 20.5";
    out property <string> plus: "M12 5 L12 19 M5 12 L19 12";
    out property <string> close: "M6 6 L18 18 M18 6 L6 18";
    out property <string> folder: "M3.5 7 A1.5 1.5 0 0 1 5 5.5 L9.5 5.5 L11.5 7.5 L19 7.5 A1.5 1.5 0 0 1 20.5 9 L20.5 17 A1.5 1.5 0 0 1 19 18.5 L5 18.5 A1.5 1.5 0 0 1 3.5 17 Z";
    out property <string> replay: "M4.5 12 A7.5 7.5 0 1 0 6.7 6.7 M5.5 3.5 L5.5 7.5 L9.5 7.5";
    out property <string> gamepad: "M7.5 7 L16.5 7 A5 5 0 0 1 21.5 12 L21.5 13.5 A3.5 3.5 0 0 1 15.5 16 L14.5 15 L9.5 15 L8.5 16 A3.5 3.5 0 0 1 2.5 13.5 L2.5 12 A5 5 0 0 1 7.5 7 Z M7.5 9.5 L7.5 12.5 M6 11 L9 11 M15.5 10.5 L15.6 10.5 M17.5 12 L17.6 12";
    out property <string> check: "M5 12.5 L10 17 L19 7.5";
    out property <string> alert: "M12 3.5 A8.5 8.5 0 1 1 12 20.5 A8.5 8.5 0 1 1 12 3.5 Z M12 7.5 L12 12.5 M12 16 L12 16.1";
    out property <string> info: "M12 3.5 A8.5 8.5 0 1 1 12 20.5 A8.5 8.5 0 1 1 12 3.5 Z M12 11 L12 16.5 M12 7.9 L12 8";
    out property <string> save: "M12 4 L12 14.5 M7.5 10 L12 14.5 L16.5 10 M5 19.5 L19 19.5";
    out property <string> chevron-up: "M6.5 14.5 L12 9 L17.5 14.5";
    out property <string> chevron-down: "M6.5 9.5 L12 15 L17.5 9.5";
    out property <string> chevron-left: "M14.5 6.5 L9 12 L14.5 17.5";
    out property <string> arrow-up: "M12 19 L12 5.5 M6.5 11 L12 5.5 L17.5 11";
    out property <string> arrow-down: "M12 5 L12 18.5 M6.5 13 L12 18.5 L17.5 13";
    out property <string> layers: "M12 3.5 L21 8 L12 12.5 L3 8 Z M3 12 L12 16.5 L21 12 M3 16 L12 20.5 L21 16";
    out property <string> image: "M5 4.5 L19 4.5 A1.5 1.5 0 0 1 20.5 6 L20.5 18 A1.5 1.5 0 0 1 19 19.5 L5 19.5 A1.5 1.5 0 0 1 3.5 18 L3.5 6 A1.5 1.5 0 0 1 5 4.5 Z M3.5 16 L8.5 11 L13 15.5 L15.5 13 L20.5 18 M15.5 7.6 A1.4 1.4 0 1 1 15.5 10.4 A1.4 1.4 0 1 1 15.5 7.6 Z";
    out property <string> text: "M5 7 L5 5 L19 5 L19 7 M12 5 L12 19 M9 19 L15 19";
    out property <string> camera: "M4 7 L15 7 A1.5 1.5 0 0 1 16.5 8.5 L16.5 15.5 A1.5 1.5 0 0 1 15 17 L4 17 A1.5 1.5 0 0 1 2.5 15.5 L2.5 8.5 A1.5 1.5 0 0 1 4 7 Z M16.5 10.5 L21.5 7.5 L21.5 16.5 L16.5 13.5";
    out property <string> eye: "M2.5 12 C5 7.5 8.5 5.5 12 5.5 C15.5 5.5 19 7.5 21.5 12 C19 16.5 15.5 18.5 12 18.5 C8.5 18.5 5 16.5 2.5 12 Z M12 9.2 A2.8 2.8 0 1 1 12 14.8 A2.8 2.8 0 1 1 12 9.2 Z";
    out property <string> eye-off: "M2.5 12 C5 7.5 8.5 5.5 12 5.5 C15.5 5.5 19 7.5 21.5 12 C19 16.5 15.5 18.5 12 18.5 C8.5 18.5 5 16.5 2.5 12 Z M12 9.2 A2.8 2.8 0 1 1 12 14.8 A2.8 2.8 0 1 1 12 9.2 Z M4 4 L20 20";
    out property <string> trash: "M4.5 7 L19.5 7 M9.5 7 L9.5 4.5 L14.5 4.5 L14.5 7 M6.5 7 L7.5 19.5 L16.5 19.5 L17.5 7 M10 10.5 L10 16 M14 10.5 L14 16";
    out property <string> broadcast: "M12 10.6 A1.4 1.4 0 1 1 12 13.4 A1.4 1.4 0 1 1 12 10.6 Z M8.6 8.6 A4.8 4.8 0 0 0 8.6 15.4 M15.4 8.6 A4.8 4.8 0 0 1 15.4 15.4 M5.6 5.6 A9 9 0 0 0 5.6 18.4 M18.4 5.6 A9 9 0 0 1 18.4 18.4";
}
