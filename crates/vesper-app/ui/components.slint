// Small, keyboard-accessible building blocks styled with `Theme`.

import { Theme, Icons } from "theme.slint";

// A stroked 24x24 icon.
export component Icon inherits Rectangle {
    in property <string> data;
    in property <brush> tint: Theme.text;
    in property <length> stroke: 1.75px;
    width: 20px;
    height: 20px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.data;
        stroke: root.tint;
        stroke-width: root.stroke;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
}

// The Vesper mark: an evening star on the rim of a lens, around a record dot.
// Same geometry as the symbolic app icon (22x22 viewbox), cropped to its 20x20
// ink so the lens lines up with the cards' edges. The lens and the dot share
// one violet-to-red gradient; the star follows the text color.
export component Logo inherits Rectangle {
    width: 20px;
    height: 20px;
    accessible-role: image;
    accessible-label: "Vesper";
    // One gradient across the whole mark: each path spans the full viewbox.
    property <brush> glow: @linear-gradient(135deg, Theme.accent 0%, Theme.rec 100%);
    for commands in [
        "M18.795 9.2A8 8 0 1 1 12.8 3.205A0.75 0.75 0 0 1 12.462 4.667A6.5 6.5 0 1 0 17.333 9.538A0.75 0.75 0 0 1 18.795 9.2Z",
        "M8 11A3 3 0 1 1 14 11A3 3 0 1 1 8 11Z",
    ]: Path {
        width: 100%;
        height: 100%;
        viewbox-x: 2;
        viewbox-y: 1;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: commands;
        fill: root.glow;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 2;
        viewbox-y: 1;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: "M16.5 2Q17.05 4.95 20 5.5Q17.05 6.05 16.5 9Q15.95 6.05 13 5.5Q15.95 4.95 16.5 2Z";
        fill: Theme.text;
    }
}

// Keyboard focus indicator drawn around a control.
// Fills its parent; the ring itself sits 3px outside.
export component FocusRing inherits Rectangle {
    in property <bool> visible-ring;
    in property <length> radius;
    in property <length> offset: 3px;
    Rectangle {
        x: -root.offset;
        y: -root.offset;
        width: root.width + 2 * root.offset;
        height: root.height + 2 * root.offset;
        border-radius: root.radius + root.offset;
        border-width: root.visible-ring ? 2px : 0px;
        border-color: Theme.accent;
    }
}

// Card that groups related controls.
export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
}

// Text button. `kind`: "secondary" (default), "primary", "ghost".
// `small`: 28px high, for inline actions in dense rows.
export component Button inherits FocusScope {
    in property <string> text;
    in property <string> icon;
    in property <string> kind: "secondary";
    in property <bool> small;
    in property <string> shortcut-hint;
    callback clicked;

    focus-on-click: false;
    min-height: root.small ? Theme.control-height-sm : Theme.control-height;
    min-width: layout.min-width;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.shortcut-hint;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            if (root.enabled) { root.clicked(); }
            return accept;
        }
        reject
    }

    FocusRing {
        visible-ring: root.has-focus;
        radius: root.small ? Theme.radius-sm : Theme.radius-md;
    }

    bg := Rectangle {
        border-radius: root.small ? Theme.radius-sm : Theme.radius-md;
        border-width: root.kind == "secondary" ? 1px : 0px;
        border-color: Theme.border-strong;
        background: root.kind == "primary"
            ? (touch.pressed ? Theme.accent.darker(0.15) : touch.has-hover ? Theme.accent-hover : Theme.accent)
            : root.kind == "ghost"
                ? (touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-hover : transparent)
                : (touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-hover : Theme.surface-raised);
        opacity: root.enabled ? 1 : 0.4;
        animate background { duration: Theme.fast; }
    }

    layout := HorizontalLayout {
        padding-left: root.small ? 10px : root.icon != "" ? 12px : 16px;
        padding-right: root.small ? 10px : 16px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            data: root.icon;
            tint: root.kind == "primary" ? Theme.on-accent : Theme.text;
            opacity: root.enabled ? 1 : 0.4;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: root.small ? Theme.font-small : Theme.font-body;
            font-weight: 600;
            color: root.kind == "primary" ? Theme.on-accent : Theme.text;
            opacity: root.enabled ? 1 : 0.4;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// Square icon-only button. `active` gives it a toggled look.
export component IconButton inherits FocusScope {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    in property <brush> active-tint: Theme.accent;
    in property <brush> tint: Theme.text-muted;
    callback clicked;

    focus-on-click: false;
    width: Theme.control-height;
    height: Theme.control-height;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.label;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            if (root.enabled) { root.clicked(); }
            return accept;
        }
        reject
    }

    FocusRing {
        visible-ring: root.has-focus;
        radius: Theme.radius-md;
    }

    Rectangle {
        border-radius: Theme.radius-md;
        background: touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-hover : transparent;
        animate background { duration: Theme.fast; }
    }

    Icon {
        data: root.icon;
        tint: root.active ? root.active-tint : touch.has-hover ? Theme.text : root.tint;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// On/off switch.
export component Switch inherits FocusScope {
    // Stateless: the parent owns `checked` and updates it from `toggled`.
    in property <bool> checked;
    in property <string> label;
    callback toggled(bool);

    focus-on-click: false;
    width: 44px;
    height: 26px;
    accessible-role: switch;
    accessible-enabled: root.enabled;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.toggle();
    }

    function toggle() {
        if (root.enabled) {
            root.toggled(!root.checked);
        }
    }

    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            root.toggle();
            return accept;
        }
        reject
    }

    FocusRing {
        visible-ring: root.has-focus;
        radius: self.height / 2;
    }

    track := Rectangle {
        border-radius: self.height / 2;
        // Same dimming as a disabled button: visibly not available.
        opacity: root.enabled ? 1 : 0.4;
        background: root.checked ? Theme.accent : Theme.border-strong;
        animate background { duration: Theme.fast; }

        knob := Rectangle {
            width: 20px;
            height: 20px;
            y: 3px;
            x: root.checked ? parent.width - self.width - 3px : 3px;
            border-radius: self.height / 2;
            background: #ffffff;
            drop-shadow-blur: 3px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 1px;
            animate x { duration: Theme.medium; easing: ease-out-quart; }
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.toggle();
        }
    }
}

// Mutually exclusive options in a pill. Left/Right arrows move the selection.
// Every option gets an equal cell, the thumb covers exactly one cell and each
// label is centered in its cell, whatever the label lengths.
export component Segmented inherits FocusScope {
    in property <[string]> options;
    in property <string> label;
    // Stateless: the parent owns `selected` and updates it from `changed`.
    in property <int> selected;
    callback changed(int);

    property <length> inset: 3px;
    property <length> cell: (self.width - 2 * self.inset) / max(1, root.options.length);

    focus-on-click: false;
    min-height: Theme.segmented-height;
    preferred-height: Theme.segmented-height;
    vertical-stretch: 0;
    accessible-role: radio-group;
    accessible-enabled: root.enabled;
    accessible-label: root.label;
    accessible-value: root.options[root.selected];

    function select(i: int) {
        if (root.enabled && i >= 0 && i < root.options.length && i != root.selected) {
            root.changed(i);
        }
    }

    key-pressed(event) => {
        if (event.text == Key.LeftArrow) {
            root.select(root.selected - 1);
            return accept;
        }
        if (event.text == Key.RightArrow) {
            root.select(root.selected + 1);
            return accept;
        }
        reject
    }

    FocusRing {
        visible-ring: root.has-focus;
        radius: Theme.radius-md;
    }

    Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.surface-raised;
        opacity: root.enabled ? 1 : 0.45;

        // Sliding thumb under the selected option.
        Rectangle {
            x: root.inset + root.cell * root.selected;
            y: root.inset;
            width: root.cell;
            height: parent.height - 2 * root.inset;
            border-radius: Theme.radius-md - root.inset;
            background: Theme.dark ? Theme.surface-pressed : Theme.surface;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: Theme.dark ? 0px : 4px;
            drop-shadow-color: #0000001a;
            drop-shadow-offset-y: 1px;
            animate x { duration: Theme.medium; easing: ease-out-quart; }
        }

        for option[i] in root.options: TouchArea {
            x: root.inset + root.cell * i;
            y: root.inset;
            width: root.cell;
            height: parent.height - 2 * root.inset;
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            accessible-role: radio-button;
            accessible-label: option;
            accessible-checkable: true;
            accessible-checked: i == root.selected;
            accessible-action-default => {
                root.select(i);
            }
            clicked => {
                root.select(i);
            }
            Text {
                x: Theme.space-xs;
                width: parent.width - 2 * Theme.space-xs;
                text: option;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: Theme.font-small;
                font-weight: i == root.selected ? 600 : 500;
                color: i == root.selected ? Theme.text : parent.has-hover ? Theme.text : Theme.text-muted;
            }
        }
    }
}

// Horizontal audio level meter. `level` is linear 0..1.
export component Meter inherits Rectangle {
    in property <float> level;
    in property <bool> muted;
    // Peak hold, driven by the caller.
    in property <float> peak;

    height: 6px;
    border-radius: self.height / 2;
    background: Theme.meter-track;
    clip: true;
    // Purely visual: a 30 Hz value would flood screen readers. The mute
    // button next to it carries the accessible state.
    accessible-role: none;

    fill := Rectangle {
        x: 0;
        width: root.muted ? 0 : parent.width * clamp(root.level, 0, 1);
        border-radius: parent.border-radius;
        clip: true;
        // No `animate`: the levels are smoothed in Rust (meter.rs) and only
        // change by a visible step, so a resting meter costs no frame.
        // Full-width gradient revealed by the fill, so "hot" only shows near 0 dBFS.
        Rectangle {
            x: 0;
            width: root.width;
            background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent 72%, Theme.meter-hot 92%);
        }
    }

    if !root.muted && root.peak > 0.02: Rectangle {
        x: (parent.width - self.width) * clamp(root.peak, 0, 1);
        width: 2px;
        background: root.peak > 0.9 ? Theme.meter-hot : Theme.text-muted;
    }
}

// Horizontal slider. Arrows step by `step`, PageUp/PageDown by `page-step`,
// Home/End jump to the ends, a double click restores `default-value`.
export component Slider inherits FocusScope {
    // Stateless: the parent owns `value` and updates it from `changed`.
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.1;
    // PageUp / PageDown.
    in property <float> page-step: 1;
    in property <float> default-value;
    in property <string> label;
    // Spoken value, e.g. "-3 dB".
    in property <string> value-text;
    callback changed(float);

    property <float> ratio: (clamp(root.value, root.minimum, root.maximum) - root.minimum) / (root.maximum - root.minimum);
    property <length> knob: 16px;

    // Arrows work right after a click.
    focus-on-click: true;
    min-width: 80px;
    height: 24px;
    accessible-role: slider;
    accessible-enabled: root.enabled;
    accessible-label: root.label;
    accessible-value: root.value-text;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => {
        root.set(root.value + root.step);
    }
    accessible-action-decrement => {
        root.set(root.value - root.step);
    }

    function set(v: float) {
        if (root.enabled) {
            root.changed(clamp(v, root.minimum, root.maximum));
        }
    }

    function set-at(x: length) {
        root.set(root.minimum + (root.maximum - root.minimum) * clamp((x - root.knob / 2) / (root.width - root.knob), 0, 1));
    }

    key-pressed(event) => {
        if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
            root.set(root.value - root.step);
            return accept;
        }
        if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
            root.set(root.value + root.step);
            return accept;
        }
        if (event.text == Key.Home) {
            root.set(root.minimum);
            return accept;
        }
        if (event.text == Key.PageUp) {
            root.set(root.value + root.page-step);
            return accept;
        }
        if (event.text == Key.PageDown) {
            root.set(root.value - root.page-step);
            return accept;
        }
        if (event.text == Key.End) {
            root.set(root.maximum);
            return accept;
        }
        reject
    }

    FocusRing {
        visible-ring: root.has-focus;
        radius: self.height / 2;
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.meter-track;
        opacity: root.enabled ? 1 : 0.4;
        Rectangle {
            x: 0;
            width: root.knob / 2 + (root.width - root.knob) * root.ratio;
            border-radius: parent.border-radius;
            background: Theme.accent;
        }
    }

    Rectangle {
        x: (root.width - self.width) * root.ratio;
        y: (parent.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: self.width / 2;
        background: #ffffff;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 1px;
        opacity: root.enabled ? 1 : 0.4;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.set-at(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-at(self.mouse-x);
            }
        }
        double-clicked => {
            root.set(root.default-value);
        }
    }
}

// Single-line text entry. Commits on Enter or when it loses focus, then
// shows `text` again (as the parent cleaned or refused it); Escape puts
// `text` back. `edited` reports each change, so a parent that removes the
// field mid-edit can still commit it. `password` hides what is typed;
// `placeholder` shows while it is empty.
export component TextField inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> password;
    in property <string> placeholder;
    callback accepted(string);
    callback edited(string);

    height: 32px;
    border-radius: Theme.radius-sm;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border-strong;
    opacity: root.enabled ? 1 : 0.4;

    if input.text == "" && root.placeholder != "": Text {
        x: input.x;
        width: input.width;
        height: 100%;
        text: root.placeholder;
        vertical-alignment: center;
        font-size: Theme.font-body;
        color: Theme.text-faint;
        overflow: elide;
        accessible-role: none;
    }

    input := TextInput {
        x: Theme.space-sm + 2px;
        width: parent.width - 2 * self.x;
        height: 100%;
        text: root.text;
        enabled: root.enabled;
        input-type: root.password ? InputType.password : InputType.text;
        single-line: true;
        vertical-alignment: center;
        font-size: Theme.font-body;
        color: Theme.text;
        selection-background-color: Theme.accent-soft;
        selection-foreground-color: Theme.text;
        accessible-label: root.label;
        accepted => {
            root.accepted(self.text);
            self.text = root.text;
        }
        edited => {
            root.edited(self.text);
        }
        key-pressed(event) => {
            if (event.text == Key.Escape && self.text != root.text) {
                self.text = root.text;
                root.edited(self.text);
                return accept;
            }
            reject
        }
        changed has-focus => {
            if (!self.has-focus && self.text != root.text) {
                root.accepted(self.text);
                self.text = root.text;
            }
        }
    }
}

// Shows the current choice; activating it opens or closes the list of
// choices, which the parent shows below it. Stateless: the parent owns
// `expanded`. `warn` tints a choice that is not available right now;
// `description` tells why the field is disabled.
export component SelectField inherits FocusScope {
    in property <string> text;
    in property <string> label;
    in property <string> icon;
    in property <bool> expanded;
    in property <bool> warn;
    in property <string> description;
    // The last activation came from the keyboard: the list should take focus.
    out property <bool> keyboard;
    callback clicked;

    focus-on-click: false;
    height: Theme.control-height;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.text;
    accessible-description: root.description;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return || (event.text == Key.DownArrow && !root.expanded) || (event.text == Key.Escape && root.expanded)) {
            if (root.enabled) {
                root.keyboard = true;
                root.clicked();
            }
            return accept;
        }
        reject
    }

    FocusRing {
        visible-ring: root.has-focus;
        radius: Theme.radius-md;
    }

    Rectangle {
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: root.expanded ? Theme.accent : Theme.border-strong;
        background: touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-hover : Theme.surface-raised;
        opacity: root.enabled ? 1 : 0.4;
        animate background { duration: Theme.fast; }
    }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-sm;
        spacing: Theme.space-sm;
        opacity: root.enabled ? 1 : 0.4;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            data: root.icon;
            tint: Theme.text-muted;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.font-body;
            color: root.warn ? Theme.warn : Theme.text;
            overflow: elide;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            data: root.expanded ? Icons.chevron-up : Icons.chevron-down;
            tint: Theme.text-muted;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.keyboard = false;
            // Closing: focus leaves the list for the field.
            if (root.expanded) {
                root.focus();
            }
            root.clicked();
        }
    }
}

// Small caption used as a section label.
export component SectionLabel inherits Text {
    font-size: Theme.font-caption;
    font-weight: 600;
    letter-spacing: 0.8px;
    color: Theme.text-faint;
}
