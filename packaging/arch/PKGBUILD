# Maintainer: Paul Carouge
#
# Builds the last commit of the local checkout this file lives in (two
# levels up), so no GitHub credentials are needed: `makepkg -si` here.
# Uncommitted changes are not packaged.

pkgname=vesper-git
pkgver=0.1.0
pkgrel=1
pkgdesc='Fast, bloat-free screen recorder with replay buffer and Vulkan/OpenGL game capture'
arch=('x86_64')
url='https://github.com/Paul-Carouge/vesper'
# No license file in the repository yet.
license=('custom')
# Linked: ffmpeg, libva, pipewire, fontconfig. Loaded at runtime by the UI:
# libEGL/libGL (libglvnd), libwayland-*, libxkbcommon. mesa: VAAPI driver.
depends=(
  'ffmpeg'
  'fontconfig'
  'gcc-libs'
  'glibc'
  'libglvnd'
  'libva'
  'libxkbcommon'
  'mesa'
  'pipewire'
  'wayland'
  'xdg-desktop-portal'
)
optdepends=(
  'vulkan-icd-loader: game capture (the opt-in Vulkan layer)'
  'lib32-vulkan-icd-loader: game capture of 32-bit Vulkan games'
  'lib32-mesa: game capture of 32-bit OpenGL games'
  'xdg-desktop-portal-kde: screen capture and global shortcuts on KDE'
)
makedepends=('cargo' 'clang' 'git')
provides=('vesper')
conflicts=('vesper')
# makepkg's -flto turns libspa's C shims into GCC bytecode that rust-lld
# cannot link (undefined libspa_rs_* symbols). Cargo does its own thin LTO.
options=('!lto')
# Pinned to the checkout's HEAD: otherwise a rebuild after a branch switch
# reuses the old clone's origin/HEAD and silently packages an older commit.
source=("vesper::git+file://$(realpath "$startdir/../..")#commit=$(git -C "$startdir" rev-parse HEAD)")
sha256sums=('SKIP')

# The 32-bit game capture libraries (32-bit Vulkan layer and OpenGL
# interposer, in /usr/lib32/vesper/) are built only when the i686 Rust target
# and a 32-bit C toolchain are there: `rustup target add
# i686-unknown-linux-gnu` (or lib32-rust-libs with the system rust), and
# lib32-glibc + lib32-gcc-libs (multilib). Without them the package has no
# 32-bit game capture.
_i686=i686-unknown-linux-gnu
_lib32() {
  [ -d "$(rustc --print target-libdir --target $_i686 2>/dev/null)" ] \
    && echo 'int main(void){return 0;}' | cc -m32 -x c - -o /dev/null 2>/dev/null
}

pkgver() {
  cd vesper
  local version
  version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd vesper
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  if _lib32; then cargo fetch --locked --target $_i686; fi
}

build() {
  cd vesper
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --locked --frozen --workspace
  if _lib32; then
    # A failed 32-bit build must not leave stale libraries to package.
    cargo build --release --locked --frozen --target $_i686 -p vesper-vklayer -p vesper-glcapture \
      || { echo "32-bit build failed: no 32-bit game capture" >&2; rm -rf target/$_i686; }
  else
    echo "No i686 Rust target or 32-bit toolchain: no 32-bit game capture" >&2
  fi
}

check() {
  cd vesper
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --release --locked --frozen --workspace
}

package() {
  cd vesper
  install -Dm755 target/release/vesper -t "$pkgdir/usr/bin/"
  # Only the library: the per-user settings switch is the only way to enable
  # it, so no manifest in /usr/share/vulkan/implicit_layer.d/.
  install -Dm644 target/release/libvesper_vklayer.so -t "$pkgdir/usr/lib/vesper/"
  # OpenGL games: only through `vesper-gl %command%`, per game (LD_PRELOAD).
  install -Dm644 target/release/libvesper_glcapture.so -t "$pkgdir/usr/lib/vesper/"
  install -Dm755 crates/vesper-glcapture/vesper-gl -t "$pkgdir/usr/bin/"
  if _lib32 && [ -f target/$_i686/release/libvesper_vklayer.so ] \
    && [ -f target/$_i686/release/libvesper_glcapture.so ]; then
    install -Dm644 target/$_i686/release/libvesper_vklayer.so \
      target/$_i686/release/libvesper_glcapture.so -t "$pkgdir/usr/lib32/vesper/"
  fi
  # VST3 plugin host, started by Vesper (one process per plugin instance).
  install -Dm755 target/release/vesper-vst-host -t "$pkgdir/usr/lib/vesper/"
  install -Dm644 crates/vesper-app/data/io.github.PaulCarouge.Vesper.desktop \
    -t "$pkgdir/usr/share/applications/"
  # App icon at every hicolor size plus scalable; the symbolic tray icons
  # (apps/ and status/) follow the panel's text color.
  install -dm755 "$pkgdir/usr/share/icons"
  cp -r --no-preserve=ownership crates/vesper-app/data/icons/hicolor "$pkgdir/usr/share/icons/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
